---
import { getLangFromUrl, useTranslations } from "~/i18n/utils"
import Layout from "~/layouts/Layout.astro"
import IconLeft from "~icons/tabler/arrow-big-left-lines-filled"

export { getStaticPaths } from "./index.astro"

export const prerender = true

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout title={t("404.title")} displayFont>
  <main class="flex-1 flex flex-col items-center justify-center py-16 md:py-24">
    <div class="container-page grid-page items-center gap-y-10">

      <div class="order-2 col-span-4 flex flex-col items-center gap-8 text-center md:order-1 md:col-span-7 md:items-start md:text-left">
        <a href="https://rustlang-es.org/" target="_blank" rel="noopener noreferrer" class="inline-flex">
          <img
            src="/Rust_Lang_ES_Logo_Blanco_color.svg"
            alt={t("404.image_alt")}
            width="160"
            class="rounded-control border border-line bg-code-bg p-3 shadow-hard-sm"
          >
        </a>

        <div class="flex flex-col gap-4">
          <h1 class="font-display text-6xl leading-none font-extrabold text-ink md:text-8xl">
            404<span class="text-ferris-ink">_</span>
          </h1>

          <h2 class="type-h3 text-ink">
            {t("404.title_description")}
          </h2>

          <div class="code-surface flex flex-col gap-2 p-4 font-mono text-sm md:text-base text-left">
            <p class="text-code-muted">{t("404.c_reference")}</p>
            <p class="text-ferris border-t border-code-line pt-3 mt-1">
              // {t("404.problem")}
            </p>
          </div>
        </div>

        <a
          href={`/${lang}/`}
          class="group btn btn-primary"
        >
          <IconLeft class="transition-transform duration-150 group-hover:-translate-x-1" font-size={20} />
          {t("404.back_home")}
        </a>
      </div>

      <img
        src="/images/brand/ferris-hero-900.webp"
        srcset="/images/brand/ferris-hero-480.webp 480w, /images/brand/ferris-hero-900.webp 900w"
        sizes="(min-width: 768px) 420px, calc(100vw - 32px)"
        alt=""
        aria-hidden="true"
        width="900"
        height="551"
        class="order-1 col-span-4 h-auto w-full md:order-2 md:col-span-5"
      />
    </div>
  </main>
</Layout>
