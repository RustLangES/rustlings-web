---
import { getLangFromUrl, useTranslations } from "~/i18n/utils"
import Layout from "~/layouts/Layout.astro"
import IconChevronLeft from "~icons/tabler/chevron-left"

export const prerender = true

export function getStaticPaths() {
	return [{ params: { lang: "es" } }, { params: { lang: "en" } }]
}

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout
  title={t("privacy.meta_title")}
  description={t("privacy.meta_description")}
>
  <main class="flex-1 container-page grid-page py-16 md:py-24">
    <div class="col-span-4 md:col-span-12 lg:col-span-8">
      <a
        href={`/${lang}/`}
        class="btn-ghost -ml-2.5 mb-10 text-ink-muted"
      >
        <IconChevronLeft font-size={16} />
        {t("privacy.back_home")}
      </a>

      <h1 class="type-h1 text-ink mb-2">{t("privacy.title")}</h1>
      <p class="text-sm text-ink-subtle mb-10">{t("privacy.last_updated")}</p>

      <div class="flex flex-col gap-10 text-ink-muted text-base leading-[1.7]">

        <section class="flex flex-col gap-3">
          <h2 class="type-h4 text-ink">{t("privacy.section1_title")}</h2>
          <p>
            <strong class="text-ink font-semibold">Rustlings Web</strong> {t("privacy.section1_content")}
            <a
              href="https://github.com/RustLangES/rustlings-web"
              target="_blank"
              rel="noopener noreferrer"
              class="text-ferris-ink underline underline-offset-2 hover:no-underline"
            >GitHub</a>.
          </p>
        </section>

        <section class="flex flex-col gap-3">
          <h2 class="type-h4 text-ink">{t("privacy.section2_title")}</h2>
          <p>
            {t("privacy.section2_intro")}
          </p>
          <ul class="list-disc list-inside flex flex-col gap-1 pl-2">
            <li>{t("privacy.section2_item1")}</li>
            <li>{t("privacy.section2_item2")}</li>
            <li>{t("privacy.section2_item3")}</li>
            <li>{t("privacy.section2_item4")}</li>
          </ul>
          <p>
            {t("privacy.section2_conclusion")}
          </p>
        </section>

        <section class="flex flex-col gap-3">
          <h2 class="type-h4 text-ink">{t("privacy.section3_title")}</h2>
          <p>{t("privacy.section3_intro")}</p>
          <div class="overflow-x-auto">
            <table class="w-full text-sm mt-2">
              <thead>
                <tr class="text-ink">
                  <th>{t("privacy.table_cookie")}</th>
                  <th>{t("privacy.table_type")}</th>
                  <th>{t("privacy.table_purpose")}</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="font-mono text-ink">_clck</td>
                  <td>{t("privacy.table_own")}</td>
                  <td>{t("privacy.cookie_clck")}</td>
                </tr>
                <tr>
                  <td class="font-mono text-ink">_clsk</td>
                  <td>{t("privacy.table_own")}</td>
                  <td>{t("privacy.cookie_clsk")}</td>
                </tr>
                <tr>
                  <td class="font-mono text-ink">CLID</td>
                  <td>{t("privacy.table_third_party")}</td>
                  <td>{t("privacy.cookie_clid")}</td>
                </tr>
                <tr>
                  <td class="font-mono text-ink">MUID</td>
                  <td>{t("privacy.table_third_party")}</td>
                  <td>{t("privacy.cookie_muid")}</td>
                </tr>
                <tr>
                  <td class="font-mono text-ink">ANONCHK, MR, SM</td>
                  <td>{t("privacy.table_third_party")}</td>
                  <td>{t("privacy.cookie_others")}</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p>
            {t("privacy.section3_conclusion")}
          </p>
        </section>

        <section class="flex flex-col gap-3">
          <h2 class="type-h4 text-ink">{t("privacy.section4_title")}</h2>
          <p>
            {t("privacy.section4_content")}
          </p>
        </section>

        <section class="flex flex-col gap-3">
          <h2 class="type-h4 text-ink">{t("privacy.section5_title")}</h2>
          <p>
            {t("privacy.section5_content")}
          </p>
        </section>

        <section class="flex flex-col gap-3">
          <h2 class="type-h4 text-ink">{t("privacy.section6_title")}</h2>
          <p>{t("privacy.section6_intro")}</p>
          <ul class="list-disc list-inside flex flex-col gap-1 pl-2">
            <li><strong class="text-ink font-semibold">{t("privacy.withdraw_consent")}</strong> {t("privacy.section6_item1")} <code>{t("privacy.localStorage")}</code>.</li>
            <li><strong class="text-ink font-semibold">{t("privacy.access_rights")}</strong> {t("privacy.section6_item2")}</li>
            <li><strong class="text-ink font-semibold">{t("privacy.object_rights")}</strong> {t("privacy.section6_item3")}</li>
          </ul>
        </section>

        <section class="flex flex-col gap-3">
          <h2 class="type-h4 text-ink">{t("privacy.section7_title")}</h2>
          <p>
            {t("privacy.section7_p1")} <code>{t("privacy.cookiesAccepted")}</code> {t("privacy.localStorage")} <code>{t("privacy.localStorage")}</code>. Al recargar la página, el aviso de cookies volverá a aparecer.
          </p>
          <p>
            {t("privacy.section7_p2")}
          </p>
        </section>

        <section class="flex flex-col gap-3">
          <h2 class="type-h4 text-ink">{t("privacy.section8_title")}</h2>
          <p>
            {t("privacy.section8_content1")} <strong class="text-ink font-semibold">{t("privacy.microsoft_corp")}</strong>
            {t("privacy.section8_content2")}
            <a
              href="https://privacy.microsoft.com/es-es/privacystatement"
              target="_blank"
              rel="noopener noreferrer"
              class="text-ferris-ink underline underline-offset-2 hover:no-underline"
            >privacy.microsoft.com</a>.
          </p>
        </section>

        <section class="flex flex-col gap-3">
          <h2 class="type-h4 text-ink">{t("privacy.section9_title")}</h2>
          <p>
            {t("privacy.section9_content1")}
            <a
              href="https://discord.com/channels/778674594856960012/1292726289479893044"
              target="_blank"
              rel="noopener noreferrer"
              class="text-ferris-ink underline underline-offset-2 hover:no-underline"
            >Discord</a>
            {t("privacy.section9_content2")}
            <a
              href="https://github.com/RustLangES/rustlings-web/issues"
              target="_blank"
              rel="noopener noreferrer"
              class="text-ferris-ink underline underline-offset-2 hover:no-underline"
            >GitHub</a>.
          </p>
        </section>

      </div>
    </div>
  </main>
</Layout>
