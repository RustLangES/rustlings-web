---
import { tracks } from "~/const/tracks"
import Navbar from "~/features/content/components/Navbar.astro"
import { getLangFromUrl, useTranslations } from "~/i18n/utils"
import Layout from "~/layouts/Layout.astro"
import { getUserProgress } from "~/lib/progress-db"
import IconCertificate from "~icons/tabler/certificate"
import IconDownload from "~icons/tabler/download"
import IconEdit from "~icons/tabler/edit"
import IconLink from "~icons/tabler/link"
import IconLock from "~icons/tabler/lock"
import IconX from "~icons/tabler/x"

if (!Astro.locals.user) {
	return Astro.redirect(`/${getLangFromUrl(Astro.url)}/login`)
}

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const user = Astro.locals.user
const { DB } = Astro.locals.runtime.env

const [fullNameRow, certsResult, progress] = await Promise.all([
	DB.prepare("SELECT full_name, full_name_locked FROM users WHERE id = ?")
		.bind(user.id)
		.first<{ full_name: string | null; full_name_locked: number }>(),
	DB.prepare(
		"SELECT id, course_id, name_used, issued_at FROM user_certificates WHERE user_id = ? ORDER BY issued_at DESC",
	)
		.bind(user.id)
		.all<{ id: string; course_id: string; name_used: string; issued_at: string }>(),
	getUserProgress(DB, user.id),
])

const fullName = fullNameRow?.full_name ?? ""
const nameLocked = !!fullNameRow?.full_name_locked
const certificates = certsResult.results

const trackMap = Object.fromEntries(tracks.map((t) => [t.id, t]))
const lessonsDone = Object.values(progress).reduce((sum, slugs) => sum + slugs.length, 0)
const displayName = fullName || user.username || user.email
const initial = displayName.trim().charAt(0).toUpperCase() || "?"
const pendingTracks = tracks.filter((tr) => !tr.disabled && !certificates.find((c) => c.course_id === tr.id))
const formatDate = (iso: string) =>
	new Date(iso).toLocaleDateString(lang === "es" ? "es-MX" : "en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	})

// Read mode looks like text (not a broken field); edit mode restores the full .input affordance
const fieldClass =
	"input disabled:cursor-default disabled:border-line-soft disabled:bg-transparent disabled:text-ink disabled:opacity-100"
---

<Layout title={t("profile.title")} noindex>
  <Navbar lang={lang} />

  <main class="flex flex-1 flex-col">
    <!-- Identity + what you've achieved -->
    <section class="border-b border-line bg-hero text-on-hero">
      <div class="container-page flex flex-col gap-6 py-10 md:flex-row md:items-center md:justify-between md:py-12">
        <div class="flex min-w-0 items-center gap-4 md:gap-5">
          <span class="flex size-16 shrink-0 items-center justify-center rounded-full border border-line bg-lilac text-2xl font-extrabold text-black shadow-hard-sm md:size-20 md:text-3xl" aria-hidden="true">
            {initial}
          </span>
          <div class="min-w-0">
            <p class="type-overline mb-1 text-hero-accent">{t("profile.my_profile")}</p>
            <h1 class="type-h2 truncate">{displayName}</h1>
            <p class="truncate text-sm text-on-hero-muted">
              {user.username && <span>@{user.username} · </span>}{user.email}
            </p>
          </div>
        </div>
        <dl class="flex gap-6 md:gap-8">
          <div class="flex flex-col-reverse">
            <dt class="text-xs text-on-hero-muted">{t("profile.lessons_done")}</dt>
            <dd class="text-[28px] leading-tight font-extrabold tabular-nums">{lessonsDone}</dd>
          </div>
          <div class="flex flex-col-reverse border-l border-current/25 pl-6 md:pl-8">
            <dt class="text-xs text-on-hero-muted">{t("profile.certs_count")}</dt>
            <dd class="text-[28px] leading-tight font-extrabold tabular-nums">{certificates.length}</dd>
          </div>
        </dl>
      </div>
    </section>

    <div class="container-page grid-page gap-y-8 py-10 md:py-12 lg:items-start">
      <!-- Achievements first -->
      <section class="col-span-4 flex flex-col gap-4 md:col-span-12 lg:col-span-8" aria-labelledby="certs-title">
        <h2 id="certs-title" class="type-h4 flex items-center gap-2">
          <IconCertificate font-size={22} class="text-ferris-ink" aria-hidden="true" />
          {certificates.length > 0 ? t("profile.certificates_title") : t("profile.tracks_title")}
        </h2>

        {certificates.length === 0 && pendingTracks.length === 0 && (
          <div class="rounded-[var(--radius-card)] border border-dashed border-ink-subtle p-6 text-center">
            <p class="font-medium">{t("profile.no_certificates")}</p>
            <p class="mt-1 text-sm text-ink-muted">{t("profile.no_certificates_desc")}</p>
          </div>
        )}

        {certificates.map((cert) => {
          const track = trackMap[cert.course_id]
          const title = track ? t(track.title) : cert.course_id
          return (
            <article class="card overflow-hidden">
              <!-- Paper preview (decorative; the real artwork lives on the certificate page) -->
              <div class="flex h-28 border-b border-line bg-[#fafafa] text-[#222222] select-none" aria-hidden="true">
                <div class="w-14 shrink-0 border-r-4 border-[#ff6e1f] bg-[#fff2e5] bg-[length:auto_56px]" style="background-image: url('/images/brand/ferris-pattern.png')"></div>
                <div class="flex flex-1 flex-col justify-center px-5">
                  <p class="text-lg leading-none font-extrabold tracking-tight">CERTIFICADO</p>
                  <p class="mt-1 mb-2 text-[10px] font-semibold tracking-wider text-[#c73407] uppercase">{title}</p>
                  <p class="w-fit bg-[linear-gradient(transparent_55%,#ffd2a8_55%)] font-extrabold">{cert.name_used}</p>
                </div>
              </div>
              <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center">
                <div class="min-w-0 flex-1">
                  <p class="truncate font-semibold">{title}</p>
                  <p class="mt-0.5 text-sm text-ink-muted">{t("profile.certificate_issued")} {formatDate(cert.issued_at)}</p>
                </div>
                <div class="flex shrink-0 items-center gap-2">
                  <button
                    type="button"
                    data-copy-link={`/${lang}/verificar/${cert.id}`}
                    class="btn btn-secondary btn-sm px-3"
                    title={t("profile.certificate_copy_tooltip")}
                    aria-label={t("profile.certificate_copy_tooltip")}
                  >
                    <IconLink font-size={16} aria-hidden="true" />
                    <span class="copy-label">{t("profile.certificate_copy")}</span>
                  </button>
                  <a href={`/${lang}/certificado/${cert.course_id}`} class="btn btn-primary btn-sm px-4">
                    <IconDownload font-size={16} aria-hidden="true" />
                    {t("profile.certificate_download")}
                  </a>
                </div>
              </div>
            </article>
          )
        })}

        {pendingTracks.length > 0 && certificates.length > 0 && (
          <h2 class="type-overline mt-4 text-ink-muted">{t("profile.tracks_title")}</h2>
        )}

        {pendingTracks.map((track) => {
          const completed = (progress[track.id] ?? []).length
          const total = track.lessons
          const pct = total > 0 ? Math.round((completed / total) * 100) : 0
          const isComplete = pct === 100
          return (
            <article class="flex flex-wrap items-center gap-4 rounded-xl border border-line bg-lilac-tint p-5 shadow-hard-sm dark:bg-surface">
              <span class={`flex size-10 shrink-0 items-center justify-center rounded-xl border border-line ${isComplete ? "bg-ferris text-black" : "bg-surface text-ink-muted"}`} aria-hidden="true">
                <IconCertificate font-size={20} />
              </span>
              <div class="min-w-0 flex-1">
                <p class="truncate font-semibold">{t(track.title)}</p>
                <div class="mt-2 flex items-center gap-3">
                  <div class="h-2.5 max-w-40 flex-1 overflow-hidden rounded-full border border-line bg-sunken" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={pct} aria-label={t(track.title)}>
                    <div class="h-full bg-ferris" style={`width:${pct}%`}></div>
                  </div>
                  <span class="text-xs font-medium text-ink-muted tabular-nums">{pct}% {t("profile.progress_completed")}</span>
                </div>
              </div>
              {isComplete ? (
                <a href={`/${lang}/certificado/${track.id}`} class="btn btn-primary btn-sm shrink-0 px-4">
                  <IconCertificate font-size={16} aria-hidden="true" />
                  {t("profile.certificate_view")}
                </a>
              ) : (
                <a href={`/${lang}/aprender`} class={`badge shrink-0 ${pct > 0 ? "badge-warning" : "badge-neutral"}`}>
                  {pct > 0 ? t("profile.progress_in_progress") : t("learn.not_started")}
                </a>
              )}
            </article>
          )
        })}
      </section>

      <!-- Account + preferences -->
      <aside class="col-span-4 grid content-start items-start gap-6 md:col-span-12 md:grid-cols-2 lg:col-span-4 lg:grid-cols-1">
        <section class="card p-5 md:p-6" aria-labelledby="account-title">
          <div class="mb-5 flex items-center justify-between gap-4">
            <h2 id="account-title" class="type-overline text-ink-muted">{t("profile.account")}</h2>
            <button id="edit-profile" type="button" class="btn btn-secondary btn-sm shrink-0 px-4">
              <IconEdit font-size={16} class="edit-icon" aria-hidden="true" />
              <IconX font-size={16} class="cancel-icon hidden" aria-hidden="true" />
              <span class="edit-label">{t("profile.edit_button")}</span>
            </button>
          </div>

          <div class="flex flex-col gap-4">
            <div>
              <label class="field-label" for="username">{t("profile.username_label")}</label>
              <input id="username" type="text" value={user.username ?? ""} maxlength="30" disabled class={fieldClass} />
            </div>

            <div>
              <label class="field-label" for="full-name">{t("profile.full_name_label")}</label>
              <input
                id="full-name"
                type="text"
                value={fullName}
                maxlength="80"
                placeholder={t("profile.full_name_placeholder")}
                disabled
                class={fieldClass}
                aria-describedby="full-name-hint"
                data-locked={nameLocked ? "true" : undefined}
              />
              <p id="full-name-hint" class="mt-1.5 flex items-start gap-1.5 text-xs text-ink-muted">
                {nameLocked && <IconLock font-size={14} aria-hidden="true" class="mt-px shrink-0" />}
                <span>{nameLocked ? t("profile.locked_tooltip") : t("profile.full_name_tooltip")}</span>
              </p>
            </div>

            <div id="profile-error" role="alert" class="hidden text-sm font-medium text-danger"></div>
            <div id="profile-success" role="status" class="hidden text-sm font-medium text-success">{t("profile.success_message")}</div>

            <button id="save-profile" type="button" class="hidden btn btn-primary btn-sm self-start">
              {t("profile.save_button")}
            </button>
          </div>
        </section>

        <section class="card p-5 md:p-6" aria-labelledby="editor-title">
          <h2 id="editor-title" class="type-overline mb-4 text-ink-muted">{t("profile.editor_section")}</h2>
          <div class="flex items-center justify-between gap-4">
            <div class="flex flex-col gap-0.5">
              <span id="vim-label" class="text-sm font-medium">{t("profile.vim_mode_label")}</span>
              <span class="text-xs text-ink-muted">{t("profile.vim_mode_desc")}</span>
            </div>
            <button
              id="vim-toggle"
              type="button"
              role="switch"
              aria-checked="false"
              aria-labelledby="vim-label"
              class="group inline-flex h-10 w-14 shrink-0 cursor-pointer items-center justify-center rounded-full"
            >
              <span class="relative inline-flex h-7 w-12 items-center rounded-full border border-line bg-neutral-bg transition-colors duration-150 group-aria-checked:bg-ferris">
                <span
                  class="pointer-events-none inline-block size-5 translate-x-[3px] rounded-full border border-line bg-surface transition-transform duration-150 ease-out group-aria-checked:translate-x-[23px]"
                  aria-hidden="true"
                ></span>
              </span>
            </button>
          </div>
        </section>
      </aside>
    </div>
  </main>
</Layout>

<div
  id="profile-config"
  data-user-id={user.id}
  data-email={user.email}
  data-username={user.username ?? ""}
  data-full-name={fullName}
  data-name-locked={nameLocked ? "true" : "false"}
  data-edit-label={t("profile.edit_button")}
  data-cancel-label={t("profile.cancel_button")}
  data-save-label={t("profile.save_button")}
  data-save-loading-label={t("profile.save_button_loading")}
  data-copied-label={t("profile.certificate_copied")}
  hidden
/>

<script>
  import { initAuthStore, authActions } from "~/lib/stores/auth-store"

  document.addEventListener("astro:page-load", () => {
    const config = document.getElementById("profile-config") as HTMLElement
    const { userId, email, username, fullName, nameLocked: nameLockedStr, editLabel, cancelLabel, saveLabel, saveLoadingLabel, copiedLabel } = config.dataset
    const nameLocked = nameLockedStr === "true"

    initAuthStore(
      { id: userId!, email: email!, username: username || null, full_name: fullName || null },
      nameLocked,
    )

    const editBtn = document.getElementById("edit-profile") as HTMLButtonElement
    const saveBtn = document.getElementById("save-profile") as HTMLButtonElement
    const usernameInput = document.getElementById("username") as HTMLInputElement
    const fullNameInput = document.getElementById("full-name") as HTMLInputElement
    const errorEl = document.getElementById("profile-error")!
    const successEl = document.getElementById("profile-success")!
    const editIcon = editBtn?.querySelector(".edit-icon")
    const cancelIcon = editBtn?.querySelector(".cancel-icon")
    const editLabelEl = editBtn?.querySelector(".edit-label")

    let isEditing = false

    const enterEditMode = () => {
      isEditing = true
      usernameInput.disabled = false
      usernameInput.focus()
      if (!nameLocked) fullNameInput.disabled = false
      saveBtn.classList.remove("hidden")
      editIcon?.classList.add("hidden")
      cancelIcon?.classList.remove("hidden")
      if (editLabelEl) editLabelEl.textContent = cancelLabel!
      errorEl.classList.add("hidden")
      successEl.classList.add("hidden")
    }

    const exitEditMode = () => {
      isEditing = false
      usernameInput.disabled = true
      usernameInput.value = usernameInput.defaultValue
      fullNameInput.disabled = true
      fullNameInput.value = fullNameInput.defaultValue
      saveBtn.classList.add("hidden")
      editIcon?.classList.remove("hidden")
      cancelIcon?.classList.add("hidden")
      if (editLabelEl) editLabelEl.textContent = editLabel!
      errorEl.classList.add("hidden")
      successEl.classList.add("hidden")
    }

    editBtn?.addEventListener("click", () => {
      isEditing ? exitEditMode() : enterEditMode()
    })

    saveBtn?.addEventListener("click", async () => {
      saveBtn.disabled = true
      saveBtn.textContent = saveLoadingLabel!
      errorEl.classList.add("hidden")
      successEl.classList.add("hidden")

      const body: { username: string; fullName?: string } = { username: usernameInput.value }
      if (!nameLocked) body.fullName = fullNameInput.value

      const res = await fetch("/api/auth/profile", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      })

      saveBtn.disabled = false
      saveBtn.textContent = saveLabel!

      if (res.ok) {
        usernameInput.defaultValue = usernameInput.value
        fullNameInput.defaultValue = fullNameInput.value
        isEditing = false
        usernameInput.disabled = true
        fullNameInput.disabled = true
        saveBtn.classList.add("hidden")
        editIcon?.classList.remove("hidden")
        cancelIcon?.classList.add("hidden")
        if (editLabelEl) editLabelEl.textContent = editLabel!

        authActions.updateUser({ username: usernameInput.value })
        if (!nameLocked) authActions.updateFullName(fullNameInput.value)

        successEl.classList.remove("hidden")
        setTimeout(() => successEl.classList.add("hidden"), 3000)
      } else {
        const { error } = await res.json() as { error: string }
        errorEl.textContent = error
        errorEl.classList.remove("hidden")
      }
    })

    // Vim mode toggle
    const vimToggle = document.getElementById("vim-toggle") as HTMLButtonElement
    const getPrefs = () => JSON.parse(localStorage.getItem("preferences") ?? "{}")
    const savePrefs = (prefs: Record<string, unknown>) => localStorage.setItem("preferences", JSON.stringify(prefs))

    const vimEnabled = !!getPrefs().vimEditor
    vimToggle.setAttribute("aria-checked", String(vimEnabled))
    vimToggle.querySelector("span")!.dataset.ariaChecked = String(vimEnabled)

    vimToggle.addEventListener("click", () => {
      const prefs = getPrefs()
      const next = !prefs.vimEditor
      prefs.vimEditor = next
      savePrefs(prefs)
      vimToggle.setAttribute("aria-checked", String(next))
      window.dispatchEvent(new CustomEvent("preferences:changed", { detail: { vimEditor: next } }))
    })

    document.querySelectorAll<HTMLButtonElement>("[data-copy-link]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const path = btn.dataset.copyLink!
        const url = `${window.location.origin}${path}`
        await navigator.clipboard.writeText(url)
        const label = btn.querySelector(".copy-label")!
        const original = label.textContent
        label.textContent = copiedLabel!
        btn.classList.add("border-ferris-ink", "text-ferris-ink")
        setTimeout(() => {
          label.textContent = original
          btn.classList.remove("border-ferris-ink", "text-ferris-ink")
        }, 2000)
      })
    })
  })
</script>
