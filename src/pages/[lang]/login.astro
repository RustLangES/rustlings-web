---
import { getLangFromUrl, useTranslations } from "~/i18n/utils"
import Layout from "~/layouts/Layout.astro"
import JamGithub from "~icons/jam/github"
import IconLeft from "~icons/tabler/arrow-big-left-lines-filled"

if (Astro.locals.user) {
	return Astro.redirect(`/${getLangFromUrl(Astro.url)}/aprender`)
}

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const error = Astro.url.searchParams.get("error")
const errorMessages: Record<string, string> = {
	oauth_invalid: t("login.error_oauth_invalid"),
	oauth_token: t("login.error_oauth_token"),
	no_email: t("login.error_no_email"),
}
---

<Layout title={t("login.title")} noindex displayFont>
  <main class="container-page grid-page relative min-h-screen content-center py-24">
    <a
      href={`/${lang}/`}
      class="btn-ghost absolute top-0 left-0 m-4 md:m-8"
    >
      <IconLeft font-size={20} />
      {t("404.back_home")}
    </a>
    <div class="col-span-4 md:col-span-8 md:col-start-3 lg:col-span-6 lg:col-start-4">
      <!-- Logo / title -->
      <div class="text-center mb-8">
        <a href={`/${lang}/`} class="font-display text-2xl font-extrabold text-ferris-ink md:text-3xl">
          Rust<span class="text-ink">lings</span>
        </a>
        <p class="text-ink-muted text-sm mt-2">{t("login.tagline")}</p>
      </div>

      <!-- Card -->
      <div class="card p-6 md:p-8">
        <!-- Error banner -->
        {error && (
          <div role="alert" class="mb-6 px-4 py-3 rounded-control border border-line bg-danger-bg text-danger text-sm font-medium">
            {errorMessages[error] ?? t("login.error_default")}
          </div>
        )}

