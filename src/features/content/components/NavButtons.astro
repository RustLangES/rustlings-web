---
import { useTranslations } from "~/i18n/utils"
import IconLeft from "~icons/tabler/arrow-big-left-lines-filled"
import IconRight from "~icons/tabler/arrow-big-right-lines-filled"

interface Props {
	lang: string
	previous?: { slug: string; title: string }
	next?: { slug: string; title: string }
}

const { lang, previous, next } = Astro.props
const t = useTranslations(lang as "es" | "en")
const isNextDisabled = true

const btnBaseClass =
	"btn btn-secondary group min-w-0 max-w-[48%] justify-start gap-3 px-4 py-2 aria-disabled:pointer-events-none"
const nextBtnClass = "btn btn-primary group min-w-0 max-w-[48%] justify-end gap-3 px-4 py-2"
const iconBaseClass = "block shrink-0 transition-transform duration-150"
---

<nav class="not-prose mt-auto flex w-full items-center justify-between gap-4 px-2 pt-4 pb-2" aria-label={t("lesson_ui.nav_aria")}>
  <a
    href={previous ? `/${lang}/${previous.slug}` : undefined}
    aria-label={previous ? `${t("lesson_ui.previous")}: ${previous.title}` : undefined}
    aria-disabled={!previous}
    class={btnBaseClass}
  >
    <span class:list={[iconBaseClass, "group-hover:-translate-x-0.5"]}>
      <IconLeft font-size={20} />
    </span>
    <div class="flex min-w-0 flex-col gap-1 text-left">
      <span class="text-sm font-semibold">
        {t("lesson_ui.previous")}
      </span>
      <span class="truncate text-xs font-normal">{previous?.title || "-"}</span>
    </div>
  </a>
  <a
    id="next-lesson-btn"
    href={next ? `/${lang}/${next.slug}` : undefined}
    aria-label={next ? `${t("lesson_ui.next")}: ${next.title}` : undefined}
    aria-disabled={isNextDisabled}
    class={nextBtnClass}
  >
    <div class="flex min-w-0 flex-col gap-1 text-right">
      <span class="text-sm font-semibold">
        {t("lesson_ui.next")}
      </span>
      <span class="truncate text-xs font-normal">{next?.title || "-"}</span>
    </div>
    <span class:list={[iconBaseClass, "group-hover:translate-x-0.5"]}>
      <IconRight font-size={20} />
    </span>
  </a>
</nav>

<script>
  import { db } from "~/lib/stores/editor-store"
  import { toast } from "~/utils/toasts"

  const initNextButton = async () => {
    const btn = document.getElementById("next-lesson-btn") as HTMLAnchorElement | null
    if (!btn || !btn.href) return

    btn.addEventListener("click", (e) => {
      if (btn.ariaDisabled === "true") {
        e.preventDefault()
        toast.info(
          "Ejecuta el código",
          "El código debe ser ejecutado al menos una vez para poder avanzar a la siguiente sección",
        )
      }
    })

    if (btn.ariaDisabled !== "true") return

    const slug =
      document.querySelector<HTMLElement>("[data-slug]")?.dataset.slug ??
      window.location.pathname.slice(1)
    if (!slug) return

    const updateNextButton = async () => {
      const isCompleted = await db.isCompleted(slug)
      btn.ariaDisabled = String(!isCompleted)
    }

    await updateNextButton()

    window.addEventListener("lesson:completed", updateNextButton)
    window.addEventListener("editor:reset", updateNextButton)
  }

  document.addEventListener("astro:page-load", initNextButton)
</script>