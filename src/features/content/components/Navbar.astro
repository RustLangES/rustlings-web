---
import Sidebar from "~/components/sidebar/Sidebar.astro"
import ToggleSidebarButton from "~/components/sidebar/ToggleSidebarButton.astro"
import ThemeToggle from "~/components/ThemeToggle.astro"
import { type Content, getLessonsByLang } from "~/content-manager"
import { getLangFromUrl, useTranslations } from "~/i18n/utils"
import IconLeft from "~icons/tabler/arrow-big-left-lines-filled"
import IconBrandGithub from "~icons/tabler/brand-github"
import IconLogout from "~icons/tabler/logout"
import IconUser from "~icons/tabler/user"

interface Props {
	lang?: string
}
const { lang: langProp } = Astro.props
const lang = langProp ?? getLangFromUrl(Astro.url)
const user = Astro.locals.user
const lessons = getLessonsByLang(lang)
const t = useTranslations(lang)

// Detect special pages that show a back button instead of the sidebar toggle
const isLearnPage = Astro.url.pathname.includes("/aprender")
const isProfilePage = Astro.url.pathname.includes("/perfil")

// Language switch URLs: keep current path, swap the lang segment
const switchLang = (targetLang: string) => Astro.url.pathname.replace(/^\/(es|en)/, `/${targetLang}`)

type GroupedLesson = { parent: Content; children: Content[] }

const groupMap = new Map<number, GroupedLesson>()

for (const lesson of lessons) {
	const { major, minor } = lesson.meta
	if (minor === 0) {
		groupMap.set(major, { parent: lesson, children: [] })
	} else {
		const group = groupMap.get(major)
		if (group) group.children.push(lesson)
	}
}

const sidebarItems = [...groupMap.values()].map(({ parent, children }) => ({
	label: `${parent.meta.major}. ${t(`lesson.${parent.meta.slug}` as Parameters<typeof t>[0])}`,
	href: `/${lang}/${parent.meta.slug}`,
	children:
		children.length > 0
			? children.map((child) => ({
					label: `${parent.meta.major}.${child.meta.minor}. ${t(`lesson.${child.meta.slug}` as Parameters<typeof t>[0])}`,
					href: `/${lang}/${child.meta.slug}`,
				}))
			: undefined,
}))
---

<header class="w-full shrink-0 border-b border-line bg-canvas">
  <nav class={`relative z-50 flex min-h-16 items-center justify-between gap-2 ${isLearnPage || isProfilePage ? "container-page" : "px-4"}`}>
    <div class="flex items-center gap-2 md:gap-4">
      <a href={`/${lang}/`} class="flex shrink-0 items-center rounded-control p-1" aria-label="Rustlings Web">
        <img src="/Rust_Lang_ES_Logo_Negro_color.svg" alt="" width="52" height="32" class="h-8 w-auto dark:hidden" />
        <img src="/Rust_Lang_ES_Logo_Blanco_color.svg" alt="" width="52" height="32" class="hidden h-8 w-auto dark:block" />
      </a>
      {isLearnPage ? (
        <a href={`/${lang}/`} class="btn-ghost" aria-label={t("learn.back_home")}>
          <IconLeft font-size={20} aria-hidden="true" />
          <span class="hidden sm:inline">{t("learn.back_home")}</span>
        </a>
      ) : isProfilePage ? (
        <a href={`/${lang}/aprender`} class="btn-ghost" aria-label={t("profile.back_temario")}>
          <IconLeft font-size={20} aria-hidden="true" />
          <span class="hidden sm:inline">{t("profile.back_temario")}</span>
        </a>
      ) : (
        <ToggleSidebarButton sidebarId="content" label={t("sidebar.menu")} />
      )}
    </div>

    <div class="flex items-center gap-1 md:gap-2">
      <!-- Language selector -->
      <div class="flex items-center">
        <a
          href={switchLang("es")}
          aria-current={lang === "es" ? "true" : undefined}
          class={`inline-flex min-h-10 min-w-10 items-center justify-center rounded-control text-sm font-semibold transition-colors duration-150 ${
            lang === "es" ? "text-ferris-ink" : "text-ink-muted hover:text-ferris-ink"
          }`}
        >
          ES
        </a>
        <span class="text-ink-subtle" aria-hidden="true">|</span>
        <a
          href={switchLang("en")}
          aria-current={lang === "en" ? "true" : undefined}
          class={`inline-flex min-h-10 min-w-10 items-center justify-center rounded-control text-sm font-semibold transition-colors duration-150 ${
            lang === "en" ? "text-ferris-ink" : "text-ink-muted hover:text-ferris-ink"
          }`}
        >
          EN
        </a>
      </div>

      <ThemeToggle label={t("nav.theme")} />

      <div id="nav-user-section" style={user ? "" : "display: none"} class="flex items-center gap-1">
        <a
          id="nav-profile-link"
          href={`/${lang}/perfil`}
          class="btn-ghost"
        >
          <IconUser font-size={18} aria-hidden="true" />
          <span class="hidden sm:inline">{user?.username ?? user?.email ?? ""}</span>
        </a>
        <a
          href="/api/auth/logout"
          data-astro-reload
          title={t("nav.logout")}
          aria-label={t("nav.logout")}
          class="inline-flex size-10 items-center justify-center rounded-control text-ink-muted transition-colors duration-150 hover:text-danger"
        >
          <IconLogout font-size={18} aria-hidden="true" />
        </a>
      </div>
      <a
        id="nav-login-link"
        href={`/${lang}/login`}
        style={user ? "display: none" : ""}
        class="inline-flex size-10 items-center justify-center rounded-control text-ink-muted transition-colors duration-150 hover:text-ferris-ink"
        title={t("nav.login")}
        aria-label={t("nav.login")}
      >
        <IconUser font-size={18} aria-hidden="true" />
      </a>
    </div>
  </nav>
</header>

{!isLearnPage && !isProfilePage && (
  <Sidebar
    id="content"
    items={sidebarItems}
    title={t("sidebar.content")}
    position="left"
    logo="/logo.webp"
    backHref={`/${lang}/aprender`}
    backLabel={t("sidebar.curriculum")}
    lang={lang}
  />
)}

<script>
  import { toast } from "~/utils/toasts"
  import { initAuthStore } from "~/lib/stores/auth-store"
  import { setupNavbar, onDisplayNameChange } from "~/lib/stores/user-utils"

  document.addEventListener("astro:page-load", () => {
    // Initialize auth store from server or fetch automatically
    initAuthStore()
    
    // Setup reactive navbar (this handles all user state changes automatically)
    setupNavbar({
      profileLinkId: "nav-user-section",
      loginLinkId: "nav-login-link",
      logoutLinkId: null
    })
    
    // Update username in profile link dynamically by targeting the span
    onDisplayNameChange((displayName) => {
      const profileLink = document.getElementById("nav-profile-link")
      const usernameSpan = profileLink?.querySelector("span")
      if (usernameSpan && displayName) {
        usernameSpan.textContent = displayName
      }
    })

    document.getElementById("debug-tour-btn")?.addEventListener("click", () => {
      const tracker = document.getElementById("lesson-tracker")
      const trackTitle = tracker?.dataset.trackTitle ?? ""

      toast.success(
        tracker?.dataset.doneTitle ?? "",
        (tracker?.dataset.doneDesc ?? "").replace("{trackTitle}", trackTitle),
      )
    })
  })
</script>
