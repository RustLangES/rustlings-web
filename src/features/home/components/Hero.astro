---
import Section from "~/components/sections/Section.astro"
import { getLangFromUrl, useTranslations } from "~/i18n/utils"
import IconArrowDown from "~icons/tabler/arrow-down"
import IconArrowRight from "~icons/tabler/arrow-right"

interface Props {
	lang?: string
}

const { lang: langProp } = Astro.props
const lang = langProp ?? getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const stats = [
	{ value: "39", label: t("hero.stat_lessons") },
	{ value: "12", label: t("hero.stat_modules") },
	{ value: "0", label: t("hero.stat_installs") },
	{ value: "100%", label: t("hero.stat_free") },
]
---

<Section id="hero" className="relative w-full overflow-hidden border-b border-line bg-hero text-on-hero">
  <div class="container-page grid-page items-center gap-y-10 pt-12 pb-14 md:pt-16 md:pb-20">
    <div class="col-span-4 flex flex-col items-start md:col-span-12 lg:col-span-7">
      <p class="type-overline mb-4 text-hero-accent">{t("hero.eyebrow")}</p>

      <h1 class="mb-5">
        <span class="type-hero block">{t("hero.title_a")} <span class="marker font-extrabold">{t("hero.title_highlight")}</span>,</span>
        <span class="mt-3 block max-w-[22ch] text-2xl leading-tight font-bold tracking-[-0.02em] sm:text-3xl lg:text-[34px]">{t("hero.title_b")}</span>
      </h1>

      <p class="type-subtitle mb-8 max-w-[38ch] text-on-hero-muted">
        {t("hero.subtitle")}
      </p>

      <div class="mb-10 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a href={`/${lang}/aprender`} class="btn btn-primary group">
          <span data-auth="guest">{t("hero.start_free")}</span>
          <span data-auth="user" hidden>{t("hero.continue")}</span>
          <IconArrowRight font-size={18} aria-hidden="true" class="transition-transform duration-150 group-hover:translate-x-0.5" />
        </a>
        <a href="#how-it-works" class="btn btn-secondary">
          {t("hero.see_how")}
          <IconArrowDown font-size={18} aria-hidden="true" />
        </a>
      </div>

      <dl class="grid w-full max-w-xl grid-cols-2 gap-y-4 sm:grid-cols-4">
        {stats.map(({ value, label }, i) => (
          <div class={`flex flex-col-reverse pr-4 ${i > 0 ? "sm:border-l sm:border-current/25 sm:pl-4" : ""} ${i % 2 === 1 ? "border-l border-current/25 pl-4 sm:pl-4" : ""}`}>
            <dt class="text-xs leading-snug text-on-hero-muted">{label}</dt>
            <dd class="text-2xl leading-tight font-extrabold tabular-nums md:text-[28px]">{value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="relative col-span-4 md:col-span-8 md:col-start-3 lg:col-span-5 lg:col-start-auto">
      <img
        src="/images/brand/ferris-hero-900.webp"
        srcset="/images/brand/ferris-hero-480.webp 480w, /images/brand/ferris-hero-900.webp 900w"
        sizes="(min-width: 1024px) 412px, (min-width: 768px) 656px, calc(100vw - 32px)"
        alt={t("hero.ferris_alt")}
        width={900}
        height={551}
        class="h-auto w-full"
        fetchpriority="high"
        loading="eager"
      />
    </div>
  </div>
</Section>
