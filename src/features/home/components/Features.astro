---
import Section from "~/components/sections/Section.astro"
import { getLangFromUrl, useTranslations } from "~/i18n/utils"
import IconCertificate from "~icons/tabler/certificate"
import IconCircleCheck from "~icons/tabler/circle-check"
import IconDeviceLaptop from "~icons/tabler/device-laptop"
import IconLanguage from "~icons/tabler/language"
import IconProgress from "~icons/tabler/progress-check"

interface Props {
	lang?: string
}

const { lang: langProp } = Astro.props
const lang = langProp ?? getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Sticker-style icon tile (Figma identity: colored squares with hard shadow)
const tile = "flex size-11 shrink-0 items-center justify-center rounded-xl border border-line shadow-hard-sm text-black"
---

<Section id="features" className="w-full border-y border-line bg-section-alt py-16 md:py-24">
  <div class="container-page">
    <header class="mb-10 max-w-2xl md:mb-12">
      <p class="eyebrow mb-3">{t("features.why_choose")}</p>
      <h2 class="type-h2 mb-3">
        {t("features.everything_you_need")} {t("features.to_learn_rust")}
      </h2>
      <p class="text-ink-muted">{t("features.subtitle")}</p>
    </header>

    <div class="grid-page gap-y-6">
      <!-- Editor + real compiler: the core promise, widest card -->
      <article class="card col-span-4 grid gap-6 p-6 md:col-span-12 md:grid-cols-2 md:items-center md:p-8 lg:col-span-8">
        <div>
          <span class={`${tile} mb-5 bg-lilac`}><IconDeviceLaptop font-size={22} aria-hidden="true" /></span>
          <h3 class="type-h4 mb-2">{t("features.integrated_editor")}</h3>
          <p class="mb-4 text-ink-muted">{t("features.integrated_editor_desc")}</p>
          <p class="text-sm text-ink-muted">
            <strong class="font-semibold text-ink">{t("features.real_rust")}.</strong> {t("features.real_rust_desc")}
          </p>
        </div>
        <div class="code-surface font-mono text-xs leading-6 select-none" aria-hidden="true">
          <div class="flex items-center justify-between border-b border-code-line px-4 py-2 text-code-muted">
            <span class="text-[11px]">main.rs</span>
            <span class="flex gap-1.5">
              <span class="size-2.5 rounded-full border border-black bg-ferris"></span>
              <span class="size-2.5 rounded-full border border-black bg-lilac"></span>
              <span class="size-2.5 rounded-full border border-black bg-code-muted"></span>
            </span>
          </div>
          <div class="px-4 py-3">
            <div><span class="text-[#f87480]">fn</span> <span class="text-[#80f5b4]">main</span><span class="text-code-muted">() &lbrace;</span></div>
            <div class="pl-4"><span class="text-[#f87480]">let</span> x<span class="text-code-muted">: </span><span class="text-code-accent">i32</span> <span class="text-code-muted">=</span> <span class="text-[#f7d591]">"5"</span><span class="text-code-muted">;</span></div>
            <div><span class="text-code-muted">&rbrace;</span></div>
          </div>
          <div class="border-t border-code-line px-4 py-2.5 text-[11px] leading-5">
            <span class="text-code-danger">error[E0308]</span><span class="text-code-ink">: mismatched types</span>
            <div class="text-code-muted">expected `i32`, found `&amp;str`</div>
          </div>
        </div>
      </article>

      <!-- Español -->
      <article class="card col-span-4 flex flex-col p-6 md:col-span-6 md:p-8 lg:col-span-4">
        <span class={`${tile} mb-5 bg-ferris`}><IconLanguage font-size={22} aria-hidden="true" /></span>
        <h3 class="type-h4 mb-2">{t("features.spanish_100")}</h3>
        <p class="text-ink-muted">{t("features.spanish_100_desc")}</p>
        <p class="mt-auto pt-6" aria-hidden="true">
          <span class="inline-block rounded-xl border border-line bg-surface px-4 py-2 font-mono text-sm shadow-hard-sm">/* en español */</span>
        </p>
      </article>

      <!-- Progreso -->
      <article class="card col-span-4 flex flex-col p-6 md:col-span-6 md:p-8 lg:col-span-4">
        <span class={`${tile} mb-5 bg-lilac`}><IconProgress font-size={22} aria-hidden="true" /></span>
        <h3 class="type-h4 mb-2">{t("features.saved_progress")}</h3>
        <p class="text-ink-muted">{t("features.saved_progress_desc")}</p>
        <ul class="mt-auto space-y-2.5 pt-6" aria-hidden="true">
          {[
            { label: t("features.ownership"), pct: 100, badge: "badge-success" },
            { label: t("features.borrowing"), pct: 70, badge: "badge-warning" },
            { label: t("features.structs"), pct: 30, badge: "badge-neutral" },
          ].map(({ label, pct, badge }) => (
            <li class="flex items-center gap-3 text-xs">
              <span class="w-20 shrink-0 font-medium">{label}</span>
              <span class="h-2.5 flex-1 overflow-hidden rounded-full border border-line bg-sunken">
                <span class="block h-full bg-ferris" style={`width: ${pct}%`}></span>
              </span>
              <span class={`badge ${badge} w-12 justify-center tabular-nums`}>{pct}%</span>
            </li>
          ))}
        </ul>
      </article>

      <!-- Certificado: the reward at the end of the path -->
      <article class="card col-span-4 grid gap-6 p-6 md:col-span-12 md:grid-cols-2 md:items-center md:p-8 lg:col-span-8">
        <div>
          <span class={`${tile} mb-5 bg-ferris`}><IconCertificate font-size={22} aria-hidden="true" /></span>
          <h3 class="type-h4 mb-2">{t("features.certificate_completion")}</h3>
          <p class="text-ink-muted">{t("features.certificate_completion_desc")}</p>
        </div>
        <!-- Certificate preview is "paper": same look in both themes, like the real PNG -->
        <div class="flex overflow-hidden rounded-xl border border-black bg-[#fafafa] text-[#222222] shadow-hard-sm select-none" aria-hidden="true">
          <div class="w-12 shrink-0 border-r-4 border-[#ff6e1f] bg-[#fff2e5] bg-[length:auto_60px]" style="background-image: url('/images/brand/ferris-pattern.png')"></div>
          <div class="flex-1 px-5 py-4">
            <p class="text-lg leading-none font-extrabold tracking-tight">CERTIFICADO</p>
            <p class="mt-1 mb-3 text-[10px] font-semibold tracking-wider text-[#c73407] uppercase">{t("playground.course_name")}</p>
            <p class="inline bg-[linear-gradient(transparent_55%,#ffd2a8_55%)] text-base font-extrabold">Ferris Crustáceo</p>
            <div class="mt-4 flex items-center justify-between border-t border-black pt-2 text-[10px] text-[#5d5d5d]">
              <span>rustlings.rustlang-es.org</span>
              <span class="inline-flex size-6 items-center justify-center rounded-full border border-black bg-[#dafee9] text-[#0f8646]">
                <IconCircleCheck font-size={14} />
              </span>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</Section>
