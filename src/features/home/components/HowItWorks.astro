---
import Section from "~/components/sections/Section.astro"
import { getLangFromUrl, useTranslations } from "~/i18n/utils"
import IconArrowRight from "~icons/tabler/arrow-right"
import IconBox from "~icons/tabler/box"
import IconCertificate from "~icons/tabler/certificate"
import IconGitBranch from "~icons/tabler/git-branch"
import IconList from "~icons/tabler/list"
import IconLoader2 from "~icons/tabler/loader-2"
import IconLock from "~icons/tabler/lock"
import IconPlayerPlay from "~icons/tabler/player-play"
import IconRefresh from "~icons/tabler/refresh"
import IconStack from "~icons/tabler/stack"

interface Props {
	lang?: string
}

const { lang: langProp } = Astro.props
const lang = langProp ?? getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const topics = [
	{
		id: "ownership",
		label: "Ownership",
		group: t("how_it_works.groups.memory"),
		icon: IconLock,
		groupColor: "badge-lilac",
	},
	{
		id: "variables",
		label: "Variables",
		group: t("how_it_works.groups.fundamentals"),
		icon: IconBox,
		groupColor: "badge-ferris",
	},
	{
		id: "match",
		label: "Match",
		group: t("how_it_works.groups.control_flow"),
		icon: IconGitBranch,
		groupColor: "badge-warning",
	},
	{
		id: "structs",
		label: "Structs",
		group: t("how_it_works.groups.types"),
		icon: IconStack,
		groupColor: "badge-success",
	},
	{
		id: "enums",
		label: "Enums",
		group: t("how_it_works.groups.types"),
		icon: IconList,
		groupColor: "badge-success",
	},
	{
		id: "iteradores",
		label: "Iteradores",
		group: t("how_it_works.groups.advanced"),
		icon: IconRefresh,
		groupColor: "badge-danger",
	},
]

// Prepare translations for client-side script
const translations = {
	running: t("how_it_works.running"),
	compiledSuccess: t("how_it_works.compiled_success"),
	compilationError: t("how_it_works.compilation_error"),
	exercises: {
		ownership: {
			title: t("how_it_works.exercises.ownership.title"),
			description: t("how_it_works.exercises.ownership.desc"),
			hint: t("how_it_works.exercises.ownership.hint"),
		},
		variables: {
			title: t("how_it_works.exercises.variables.title"),
			description: t("how_it_works.exercises.variables.desc"),
			hint: t("how_it_works.exercises.variables.hint"),
		},
		match: {
			title: t("how_it_works.exercises.match.title"),
			description: t("how_it_works.exercises.match.desc"),
			hint: t("how_it_works.exercises.match.hint"),
		},
		structs: {
			title: t("how_it_works.exercises.structs.title"),
			description: t("how_it_works.exercises.structs.desc"),
			hint: t("how_it_works.exercises.structs.hint"),
		},
		enums: {
			title: t("how_it_works.exercises.enums.title"),
			description: t("how_it_works.exercises.enums.desc"),
			hint: t("how_it_works.exercises.enums.hint"),
		},
		iteradores: {
			title: t("how_it_works.exercises.iterators.title"),
			description: t("how_it_works.exercises.iterators.desc"),
			hint: t("how_it_works.exercises.iterators.hint"),
		},
	},
}
---
<Section id="how-it-works" className="w-full border-y border-line bg-section-alt py-16 md:py-24">
  <div class="container-page">
    <header class="mb-10 max-w-2xl">
      <p class="eyebrow mb-3">{t("how_it_works.section_title")}</p>
      <h2 class="type-h2 mb-3">
        {t("how_it_works.title")} {t("how_it_works.title_second_line")}
      </h2>
      <p class="text-ink-muted">{t("how_it_works.subtitle")}</p>
    </header>

    <!-- Step indicators (Figma: Steps) -->
    <ol class="mb-6 flex items-center gap-2" aria-label={t("how_it_works.section_title")}>
      {[
        { num: "1", label: t("how_it_works.step1") },
        { num: "2", label: t("how_it_works.step2") },
        { num: "3", label: t("how_it_works.step3") },
      ].map((s, i) => (
        <>
          <li class="step-indicator flex items-center gap-2" data-step-indicator={i + 1}>
            <span class="step-ind-num flex size-8 items-center justify-center rounded-full border border-line text-sm font-bold tabular-nums transition-colors duration-150">
              {s.num}
            </span>
            <span class="step-ind-label hidden text-sm font-semibold transition-colors duration-150 sm:block">{s.label}</span>
          </li>
          {i < 2 && <li class="h-px w-6 shrink-0 bg-line sm:w-10" aria-hidden="true"></li>}
        </>
      ))}
    </ol>

    <!-- Demo container -->
    <div class="card overflow-hidden">

      <!-- Step 1: Topic selection -->
      <div id="demo-step-1" class="demo-step flex-col p-5 md:p-8">
        <div class="mb-5 flex items-end justify-between gap-4">
          <div>
            <p class="type-h4">{t("how_it_works.step1")}</p>
            <p class="text-sm text-ink-muted">{t("how_it_works.step1_desc")}</p>
          </div>
          <span class="badge badge-neutral hidden sm:inline-flex">{t("how_it_works.topics_count")}</span>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {topics.map((topic) => (
            <button
              type="button"
              data-topic={topic.id}
              class="topic-btn group flex min-h-16 cursor-pointer items-center gap-3 rounded-xl border border-line bg-canvas px-4 py-3 text-left shadow-hard-sm transition-[transform,box-shadow,background-color] duration-150 hover:-translate-x-px hover:-translate-y-px hover:shadow-[3px_3px_0_0_var(--shadow)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
            >
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-line bg-lilac text-black" aria-hidden="true">
                <topic.icon font-size={20} />
              </span>
              <span class="min-w-0 flex-1">
                <span class="topic-btn-label block truncate font-semibold leading-tight">{topic.label}</span>
                <span class={`badge mt-1 ${topic.groupColor}`}>{topic.group}</span>
              </span>
              <span class="shrink-0 text-ink-subtle transition-[color,transform] duration-150 group-hover:translate-x-0.5 group-hover:text-ferris-ink" aria-hidden="true">→</span>
            </button>
          ))}
        </div>

        <p class="mt-5 text-center text-xs text-ink-subtle">{t("how_it_works.click_hint")}</p>
      </div>

      <!-- Step 2: Real CodeMirror editor -->
      <div id="demo-step-2" class="demo-step hidden flex-col">
        <div class="flex items-center justify-between gap-4 border-b border-line px-5 py-4">
          <div class="min-w-0">
            <p id="exercise-title" class="font-semibold"></p>
            <p id="exercise-desc" class="text-sm text-ink-muted"></p>
          </div>
          <button id="back-btn" type="button" class="btn-ghost shrink-0 text-sm">
            ← {t("how_it_works.change_topic")}
          </button>
        </div>

        <div class="border-b border-line bg-code-bg text-code-ink">
          <div class="flex items-center border-b border-code-line px-4 py-2">
            <span class="font-mono text-[11px] text-code-muted">main.rs</span>
          </div>
          <div id="demo-editor" class="max-h-[340px] min-h-[200px] overflow-auto text-sm"></div>
        </div>

        <div class="flex items-center justify-between gap-4 px-5 py-4">
          <p class="hidden text-sm text-ink-muted sm:block">{t("how_it_works.edit_before_run")}</p>
          <button id="demo-run-btn" type="button" class="btn btn-primary btn-sm group ml-auto">
            <IconPlayerPlay font-size={16} class="group-data-running:hidden" aria-hidden="true" />
            <IconLoader2 font-size={16} class="hidden animate-spin group-data-running:block" aria-hidden="true" />
            <span class="group-data-running:hidden">{t("how_it_works.run")}</span>
            <span class="hidden group-data-running:inline">{t("how_it_works.running")}</span>
          </button>
        </div>
      </div>

      <!-- Step 3: Real terminal output -->
      <div id="demo-step-3" class="demo-step hidden flex-col">
        <div class="flex items-center justify-between gap-4 border-b border-line px-5 py-4">
          <div class="flex items-center gap-2" role="status" aria-live="polite">
            <span id="result-status-dot" class="status-dot bg-neutral-bg"></span>
            <p id="result-status-label" class="font-semibold text-ink-muted">{t("how_it_works.running")}</p>
          </div>
          <button id="back-to-editor-btn" type="button" class="btn-ghost shrink-0 text-sm">
            ← {t("how_it_works.edit_code")}
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2">
          <div class="border-b border-line bg-code-bg text-code-ink md:border-r md:border-b-0">
            <div class="border-b border-code-line px-4 py-2.5">
              <p class="font-mono text-[11px] text-code-muted">
                <span class="text-code-success">$</span> cargo run
              </p>
            </div>
            <div id="demo-console" class="max-h-[300px] min-h-[180px] overflow-auto p-4 font-mono text-xs">
              <pre id="demo-stderr" class="m-0 mb-2 whitespace-pre-wrap border-0 bg-transparent p-0 text-code-danger shadow-none empty:hidden"></pre>
              <pre id="demo-stdout" class="m-0 whitespace-pre-wrap border-0 bg-transparent p-0 text-code-ink shadow-none empty:hidden"></pre>
              <span id="demo-cursor" class="inline-block h-3.5 w-2 animate-pulse bg-code-muted align-middle"></span>
            </div>
          </div>

          <div class="flex flex-col gap-4 p-5">
            <div id="hint-box" class="hidden rounded-xl border border-line bg-lilac-tint px-4 py-3">
              <p class="type-overline mb-1 text-lilac-ink">{t("how_it_works.what_learned")}</p>
              <p id="result-hint" class="text-sm text-ink"></p>
            </div>

            <div class="flex flex-1 items-center gap-3 rounded-xl border border-line bg-ferris-tint p-4">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-line bg-ferris text-black" aria-hidden="true">
                <IconCertificate font-size={22} />
              </span>
              <div>
                <p class="text-xs text-ink-muted">{t("how_it_works.complete_track")}</p>
                <p class="font-semibold">{t("how_it_works.certificate_fundamentals")}</p>
              </div>
            </div>

            <a href={`/${lang}/aprender`} class="btn btn-primary group w-full">
              {t("how_it_works.continue_learning")}
              <IconArrowRight font-size={16} aria-hidden="true" class="transition-transform duration-150 group-hover:translate-x-0.5" />
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</Section>

<script define:vars={{ translations }}>
  window.howItWorksTranslations = translations
</script>

<script>
  import { EditorView, keymap } from "@codemirror/view"
  import { EditorState } from "@codemirror/state"
  import { basicSetup } from "codemirror"
  import { indentWithTab } from "@codemirror/commands"
  import { gruvbox } from "~/components/editor/theme"
  import { rust } from "~/components/editor/config"
  import { rustPlayground } from "~/lib/rust-playground"

  // Get translations from global variable
  const t = window.howItWorksTranslations

  // Plain code strings for each exercise (no HTML, CodeMirror handles highlighting)
  const exercises = {
    ownership: {
      title: t.exercises.ownership.title,
      description: t.exercises.ownership.description,
      hint: t.exercises.ownership.hint,
      code: `// En Rust, las variables son por defecto "moved" en lugar de copiadas. 
// Esto significa que después de asignar s1 a s2, s1 ya no es válido. 
// Para evitar esto, puedes usar .clone() para crear una copia de s1 que se asigna a s2, 
// permitiendo que ambos sean válidos.
fn main() {
    let s1 = String::from("hola");
    let s2 = s1.clone();
    println!("s1={}, s2={}", s1, s2);
}`,
    },
    variables: {
      title: t.exercises.variables.title,
      description: t.exercises.variables.description,
      hint: t.exercises.variables.hint,
      code: `// En Rust, las variables son inmutables por defecto. 
// Para hacerlas mutables, usamos la palabra clave mut.
fn main() {
    let mut contador = 0;
    contador += 1;
    println!("contador = {}", contador);
}`,
    },
    match: {
      title: t.exercises.match.title,
      description: t.exercises.match.description,
      hint: t.exercises.match.hint,
      code: `// El operador match en Rust es una forma poderosa de realizar pattern matching.
fn main() {
    let n = 7;
    match n {
        1..=5 => println!("pequeño"),
        _     => println!("grande"),
    }
}`,
    },
    structs: {
      title: t.exercises.structs.title,
      description: t.exercises.structs.description,
      hint: t.exercises.structs.hint,
      code: `// Las structs en Rust son tipos de datos personalizados que pueden contener múltiples campos.
struct Punto { x: f64, y: f64 }

fn main() {
    let p = Punto { x: 3.0, y: 4.0 };
    println!("({}, {})", p.x, p.y);
}`,
    },
    enums: {
      title: t.exercises.enums.title,
      description: t.exercises.enums.description,
      hint: t.exercises.enums.hint,
      code: `// Los enums en Rust permiten definir un tipo que puede ser una de varias variantes.
enum Direccion { Norte, Sur, Este, Oeste }

fn main() {
    let d = Direccion::Norte;
    match d {
        Direccion::Norte => println!("¡Al norte!"),
        _ => println!("otra dirección"),
    }
}`,
    },
    iteradores: {
      title: t.exercises.iteradores.title,
      description: t.exercises.iteradores.description,
      hint: t.exercises.iteradores.hint,
      code: `// Los iteradores en Rust son lazy: solo se evalúan al llamar .collect() u otro consumidor.
fn main() {
    let nums: Vec<i32> = (1..=3)
        .map(|x| x * 2)
        .collect();
    println!("{:?}", nums);
}`,
    },
  }

  type TopicId = keyof typeof exercises

  let demoEditorView: EditorView | null = null
  let currentTopic: TopicId | "" = ""

  // ── Step indicator helpers ──────────────────────────────────────────

  function setStepIndicator(active: 1 | 2 | 3) {
    document.querySelectorAll<HTMLElement>("[data-step-indicator]").forEach((el) => {
      const n = parseInt(el.dataset.stepIndicator ?? "0")
      const isActive = n === active
      const isPast = n < active
      const numEl = el.querySelector(".step-ind-num")
      const labelEl = el.querySelector(".step-ind-label")
      if (numEl) {
        numEl.classList.toggle("bg-ferris", isActive)
        numEl.classList.toggle("text-black", isActive)
        numEl.classList.toggle("shadow-hard-sm", isActive)
        numEl.classList.toggle("bg-success-bg", isPast)
        numEl.classList.toggle("text-success", isPast)
        numEl.classList.toggle("bg-canvas", !isActive && !isPast)
        numEl.classList.toggle("text-ink-subtle", !isActive && !isPast)
      }
      if (labelEl) {
        labelEl.classList.toggle("text-ink", isActive)
        labelEl.classList.toggle("text-ink-muted", isPast)
        labelEl.classList.toggle("text-ink-subtle", !isActive && !isPast)
      }
      if (isActive) el.setAttribute("aria-current", "step")
      else el.removeAttribute("aria-current")
    })
  }

  // ── Show / hide steps ───────────────────────────────────────────────

  function showStep(n: 1 | 2 | 3) {
    document.querySelectorAll<HTMLElement>(".demo-step").forEach((el, i) => {
      const isActive = i + 1 === n
      el.classList.toggle("hidden", !isActive)
      el.classList.toggle("flex", isActive)
    })
    setStepIndicator(n)
  }

  // ── CodeMirror init (lazy — called when step 2 first shows) ────────

  function initOrUpdateEditor(code: string) {
    const el = document.getElementById("demo-editor")
    if (!el) return

    if (demoEditorView) {
      // Update existing editor content
      const doc = demoEditorView.state.doc.toString()
      demoEditorView.dispatch({ changes: { from: 0, to: doc.length, insert: code } })
      return
    }

    demoEditorView = new EditorView({
      state: EditorState.create({
        doc: code,
        extensions: [
          basicSetup,
          gruvbox,
          rust(),
          keymap.of([indentWithTab]),
          EditorView.theme({
            "&": { backgroundColor: "transparent" },
            ".cm-scroller": { padding: "12px 0" },
          }),
        ],
      }),
      parent: el,
    })
  }

  // ── Run code via Rust Playground ────────────────────────────────────

  function runCode() {
    if (!demoEditorView) return
    const code = demoEditorView.state.doc.toString()

    // Switch to step 3
    showStep(3)

    // Reset terminal UI
    const stderrEl = document.getElementById("demo-stderr")
    const stdoutEl = document.getElementById("demo-stdout")
    const statusDot = document.getElementById("result-status-dot")
    const statusLabel = document.getElementById("result-status-label")
    const hintBox = document.getElementById("hint-box")
    const cursorEl = document.getElementById("demo-cursor")
    const runBtn = document.getElementById("demo-run-btn")

    if (stderrEl) stderrEl.textContent = ""
    if (stdoutEl) stdoutEl.textContent = ""
    if (hintBox) hintBox.classList.add("hidden")
    if (cursorEl) cursorEl.hidden = false
    // stderr also carries cargo progress; it only reads as an error once the run fails
    stderrEl?.classList.replace("text-code-muted", "text-code-danger")
    if (statusDot) statusDot.className = "status-dot bg-warning-bg animate-pulse"
    if (statusLabel) { statusLabel.textContent = t.running; statusLabel.className = "font-semibold text-warning" }
    if (runBtn) runBtn.setAttribute("data-running", "")

    rustPlayground.execute(
      code,
      (_stderr, stdout) => {
        if (stderrEl) stderrEl.textContent = _stderr
        if (stdoutEl) stdoutEl.textContent = stdout
      },
      (success) => {
        if (cursorEl) cursorEl.hidden = true
        if (success) stderrEl?.classList.replace("text-code-danger", "text-code-muted")
        if (runBtn) runBtn.removeAttribute("data-running")

        if (success) {
          if (statusDot) statusDot.className = "status-dot bg-success"
          if (statusLabel) { statusLabel.textContent = t.compiledSuccess; statusLabel.className = "font-semibold text-success" }
        } else {
          if (statusDot) statusDot.className = "status-dot bg-danger"
          if (statusLabel) { statusLabel.textContent = t.compilationError; statusLabel.className = "font-semibold text-danger" }
        }

        // Show hint
        if (currentTopic && hintBox) {
          const hint = document.getElementById("result-hint")
          if (hint) hint.textContent = exercises[currentTopic].hint
          hintBox.classList.remove("hidden")
        }
      },
    )
  }

  // ── Init on page load ───────────────────────────────────────────────

  function init() {
    showStep(1)

    // Topic buttons
    document.querySelectorAll<HTMLButtonElement>("[data-topic]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const topicId = btn.dataset.topic as TopicId
        if (!topicId || !(topicId in exercises)) return
        currentTopic = topicId
        const ex = exercises[topicId]

        // Highlight selected
        document.querySelectorAll<HTMLButtonElement>("[data-topic]").forEach((b) => {
          b.classList.remove("bg-ferris-tint")
          b.classList.add("bg-canvas")
          b.removeAttribute("aria-pressed")
          b.querySelector(".topic-btn-label")?.classList.remove("text-ferris-ink")
        })
        btn.classList.add("bg-ferris-tint")
        btn.classList.remove("bg-canvas")
        btn.setAttribute("aria-pressed", "true")
        btn.querySelector(".topic-btn-label")?.classList.add("text-ferris-ink")

        // Set exercise info
        const title = document.getElementById("exercise-title")
        const desc = document.getElementById("exercise-desc")
        if (title) title.textContent = ex.title
        if (desc) desc.textContent = ex.description

        // Show editor step, init CodeMirror
        showStep(2)
        initOrUpdateEditor(ex.code)
      })
    })

    // Back button
    document.getElementById("back-btn")?.addEventListener("click", () => showStep(1))

    // Run button
    document.getElementById("demo-run-btn")?.addEventListener("click", runCode)

    // Back to editor
    document.getElementById("back-to-editor-btn")?.addEventListener("click", () => showStep(2))
  }

  document.addEventListener("astro:page-load", init)

  document.addEventListener("astro:before-swap", () => {
    if (demoEditorView) {
      demoEditorView.destroy()
      demoEditorView = null
    }
  })
</script>
