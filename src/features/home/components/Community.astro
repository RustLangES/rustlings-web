---
import Section from "~/components/sections/Section.astro"
import { getLangFromUrl, useTranslations } from "~/i18n/utils"
import FaBrandsDiscord from "~icons/fa-brands/discord"
import FaBrandsGithub from "~icons/fa-brands/github"
import IconExternalLink from "~icons/tabler/external-link"

interface Props {
	lang?: string
}

const { lang: langProp } = Astro.props
const lang = langProp ?? getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Section id="community" className="w-full border-t border-line bg-lilac-tint py-16 md:py-24">
  <div class="container-page">
    <header class="mb-10 max-w-2xl md:mb-14">
      <h2 class="type-h2 mb-3">{t("community.title")}</h2>
      <p class="type-subtitle text-ink-muted">{t("community.subtitle")}</p>
    </header>

    <div class="grid-page gap-y-6">
      <a
        href="https://discord.com/channels/778674594856960012/1292726289479893044"
        target="_blank"
        rel="noopener noreferrer"
        class="card card-interactive group relative col-span-4 flex flex-col gap-4 p-6 md:col-span-7 md:p-8 lg:col-span-8"
      >
        <IconExternalLink font-size={18} aria-hidden="true" class="absolute top-6 right-6 text-ink-subtle transition-colors duration-150 group-hover:text-lilac-ink" />
        <div class="flex items-center gap-3">
          <span class="flex size-12 items-center justify-center rounded-xl border border-line bg-[#5865F2] text-white shadow-hard-sm" aria-hidden="true">
            <FaBrandsDiscord font-size={22} />
          </span>
          <span class="type-h4">Discord</span>
        </div>
        <p class="max-w-lg text-ink-muted">{t("community.discord_desc")}</p>
      </a>

      <a
        href="https://github.com/RustLangES/rustlings-web"
        target="_blank"
        rel="noopener noreferrer"
        class="card card-interactive group relative col-span-4 flex flex-col gap-4 p-6 md:col-span-5 md:p-8 lg:col-span-4"
      >
        <IconExternalLink font-size={18} aria-hidden="true" class="absolute top-6 right-6 text-ink-subtle transition-colors duration-150 group-hover:text-lilac-ink" />
        <div class="flex items-center gap-3">
          <span class="flex size-12 items-center justify-center rounded-xl border border-line bg-ink text-canvas shadow-hard-sm" aria-hidden="true">
            <FaBrandsGithub font-size={22} />
          </span>
          <span class="type-h4">GitHub</span>
        </div>
        <p class="text-ink-muted">{t("community.github_desc")}</p>
      </a>
    </div>

  </div>
</Section>
