---
import Section from "~/components/sections/Section.astro"
import { getLessonsByLang } from "~/content-manager"
import { getLangFromUrl, useTranslations } from "~/i18n/utils"
import IconArrowRight from "~icons/tabler/arrow-right"

interface Props {
	lang?: string
}

const { lang: langProp } = Astro.props
const lang = langProp ?? getLangFromUrl(Astro.url)
const t = useTranslations(lang)

type LessonKey = Parameters<typeof t>[0]

// One stop per major module (1, 2, … 12), counting its sub-lessons
const modules = new Map<number, { slug: string; lessons: number }>()
for (const lesson of getLessonsByLang(lang)) {
	const { major, minor, slug } = lesson.meta
	const entry = modules.get(major) ?? { slug, lessons: 0 }
	if (minor === 0) entry.slug = slug
	entry.lessons += 1
	modules.set(major, entry)
}

const stops = [...modules.entries()]
	.sort(([a], [b]) => a - b)
	.map(([major, { slug, lessons }]) => ({
		major,
		title: t(`lesson.${slug}` as LessonKey),
		lessons,
	}))
---

<Section id="learning-path" className="w-full py-16 md:py-24">
  <div class="container-page">
    <header class="mb-10 flex flex-col gap-6 md:mb-12 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow mb-3">{t("path.eyebrow")}</p>
        <h2 class="type-h2 mb-3">{t("path.title")}</h2>
        <p class="text-ink-muted">{t("path.subtitle")}</p>
      </div>
      <a href={`/${lang}/aprender`} class="btn btn-secondary shrink-0 self-start md:self-auto">
        {t("path.view_all")}
        <IconArrowRight font-size={18} aria-hidden="true" />
      </a>
    </header>

    <ol class="grid-page gap-y-4">
      {stops.map(({ major, title, lessons }, i) => (
        <li class={`${i >= 6 ? "hidden sm:flex" : "flex"} col-span-4 md:col-span-6 lg:col-span-4 items-center gap-4 rounded-xl border border-line bg-lilac-tint px-4 py-3.5 shadow-hard-sm dark:bg-surface`}>
          <span class="flex size-10 shrink-0 items-center justify-center rounded-full border border-line bg-lilac text-sm font-bold text-black tabular-nums" aria-hidden="true">
            {String(major).padStart(2, "0")}
          </span>
          <span class="min-w-0 flex-1">
            <span class="block truncate font-semibold leading-tight">{title}</span>
            <span class="mt-0.5 block text-xs text-ink-muted tabular-nums">
              {lessons} {lessons === 1 ? t("path.lesson") : t("path.lessons")}
            </span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</Section>
