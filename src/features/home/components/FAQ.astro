---
import Section from "~/components/sections/Section.astro"
import { getLangFromUrl, useTranslations } from "~/i18n/utils"
import IconChevronDown from "~icons/tabler/chevron-down"

interface Props {
	lang?: string
}

const { lang: langProp } = Astro.props
const lang = langProp ?? getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const faqs = [
	{
		q: t("faq.q1"),
		a: t("faq.a1"),
	},
	{
		q: t("faq.q2"),
		a: t("faq.a2"),
	},
	{
		q: t("faq.q3"),
		a: t("faq.a3"),
	},
	{
		q: t("faq.q4"),
		a: t("faq.a4"),
	},
	{
		q: t("faq.q5"),
		a: t("faq.a5"),
	},
	{
		q: t("faq.q6"),
		a: t("faq.a6"),
	},
]
---
<Section id="faq" className="w-full py-16 md:py-24">
  <div class="container-page grid-page gap-y-10">
    <header class="col-span-4 md:col-span-12 lg:sticky lg:top-24 lg:col-span-4 lg:self-start">
      <p class="eyebrow mb-3">{t("faq.section_title")}</p>
      <h2 class="type-h2 mb-3">{t("faq.title")}</h2>
      <p class="mb-8 text-ink-muted">{t("faq.subtitle")}</p>

      <p class="mb-3 text-sm text-ink-muted">{t("faq.still_doubt")}</p>
      <a
        href="https://discord.com/channels/778674594856960012/1292726289479893044"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary"
      >
        {t("faq.ask_discord")}
      </a>
    </header>

    <div class="col-span-4 space-y-3 md:col-span-12 lg:col-span-8">
      {faqs.map((faq) => (
        <details class="faq-item group rounded-xl border border-line bg-surface transition-shadow duration-150 open:shadow-hard-sm">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold transition-colors duration-150 hover:text-ferris-ink [&::-webkit-details-marker]:hidden">
            <span>{faq.q}</span>
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-line bg-canvas transition-[transform,background-color] duration-200 group-open:rotate-180 group-open:bg-ferris group-open:text-black" aria-hidden="true">
              <IconChevronDown font-size={16} />
            </span>
          </summary>
          <p class="border-t border-line-soft px-5 pt-4 pb-5 text-ink-muted">
            {faq.a}
          </p>
        </details>
      ))}
    </div>
  </div>
</Section>
