---
import { getLangFromUrl, useTranslations } from "~/i18n/utils"
import IconLoader2 from "~icons/tabler/loader-2"
import IconPlayerPlay from "~icons/tabler/player-play"
import IconRestore from "~icons/tabler/restore"
import IconSparkles from "~icons/tabler/sparkles"
import IconTerminal from "~icons/tabler/terminal"

interface Props {
	expectedOutput?: string
	testCode?: string
}

const { expectedOutput, testCode } = Astro.props
const isTestMode = !!testCode
const t = useTranslations(getLangFromUrl(Astro.url))
---

<terminal-output
	class="group h-full flex flex-col bg-code-bg border-t border-code-line text-code-ink text-sm font-mono"
	data-expected={expectedOutput?.trim()}
	data-test-code={testCode}
>
	<header class="flex min-h-12 items-center gap-3 border-b border-code-line bg-code-raised px-3 py-1 font-sans">
		<div class="flex items-center gap-2 text-code-ink">
			<IconTerminal font-size={18} aria-hidden="true" />
			<span class="font-semibold">{t("term.output")}</span>
		</div>

		<div class="hidden flex-1 items-center rounded-control border border-code-line bg-code-bg px-2 py-1 font-mono transition-colors duration-150 focus-within:border-ferris lg:group-data-running:flex">
			<span class="mr-2 text-code-muted">›</span>
			<input
				id="stdin-input"
				type="text"
				class="w-full bg-transparent text-xs text-code-ink outline-none"
				aria-label={t("term.stdin_aria")}
			/>
		</div>

		<div class="flex-1 group-data-running:hidden"></div>

		<div class="hidden lg:flex items-center gap-2 text-xs">
			<button
				id="btn-reset"
				class="inline-flex min-h-10 cursor-pointer items-center gap-1.5 rounded-control px-3 text-sm font-semibold text-code-muted transition-colors duration-150 hover:bg-code-line hover:text-code-ink disabled:cursor-not-allowed disabled:opacity-50"
				type="button"
				aria-label={t("term.reset_aria")}
			>
				<IconRestore font-size={14} />
				<span>{t("term.reset")}</span>
			</button>

			<!--
			<button
				id="btn-format"
				class="inline-flex min-h-10 cursor-pointer items-center gap-1.5 rounded-control px-3 text-sm font-semibold text-code-muted transition-colors duration-150 hover:bg-code-line hover:text-code-ink"
				type="button"
				aria-label={t("term.format_aria")}
			>
				<IconSparkles class="group-data-formatting:hidden" font-size={14} />
				<IconLoader2 class="hidden animate-spin group-data-formatting:block" font-size={14} />
				<span class="group-data-formatting:hidden">{t("term.format")}</span>
				<span class="hidden group-data-formatting:inline">...</span>
			</button>
			-->

			<button
				id="btn-run"
				class="btn btn-primary btn-sm"
				type="button"
				aria-label={t("term.run_aria")}
			>
				<IconPlayerPlay class="group-data-running:hidden" font-size={14} />
				<IconLoader2 class="hidden animate-spin group-data-running:block" font-size={14} />
				<span class="group-data-running:hidden">{t("term.run")}</span>
				<span class="hidden group-data-running:inline">{t("term.running")}</span>
			</button>
		</div>
	</header>

	<div id="console" class="flex-1 overflow-auto p-3" tabindex="0">
		<div class="mb-2 text-code-muted">
			<span class="text-code-muted">$</span>
			<span class="text-ferris font-medium">cargo</span>
			<span>{isTestMode ? "test" : "run"}</span>
		</div>
		<pre id="stderr" class="m-0! whitespace-pre rounded-none! border-0! bg-transparent! p-0! text-sm text-code-ink shadow-none! empty:hidden"></pre>
		<hr id="separator" class="my-2 border-t border-code-line has-[~#stdout:empty]:hidden has-[+#stdout:empty]:hidden" />
		<pre id="stdout" class="m-0! whitespace-pre rounded-none! border-0! bg-transparent! p-0! text-sm text-code-ink shadow-none! empty:hidden"></pre>
	</div>

	<!-- Mobile action bar -->
	<div class="lg:hidden shrink-0 flex flex-col border-t border-code-line bg-code-raised font-sans">
		<div class="flex gap-2 p-2">
			<button
				id="btn-reset-mobile"
				type="button"
				aria-label={t("term.reset_aria")}
				class="flex-1 inline-flex min-h-10 items-center justify-center gap-2 rounded-control text-sm font-semibold text-code-muted transition-colors duration-150 hover:bg-code-line hover:text-code-ink cursor-pointer touch-manipulation"
			>
				<IconRestore font-size={18} />
				<span>{t("term.reset")}</span>
			</button>
			<!--
			<button
				id="btn-format-mobile"
				type="button"
				aria-label={t("term.format_aria")}
				class="flex-1 inline-flex min-h-10 items-center justify-center gap-2 rounded-control text-sm font-semibold text-code-muted transition-colors duration-150 hover:bg-code-line hover:text-code-ink cursor-pointer touch-manipulation"
			>
				<IconSparkles class="group-data-formatting:hidden" font-size={18} />
				<IconLoader2 class="hidden animate-spin group-data-formatting:block" font-size={18} />
				<span class="group-data-formatting:hidden">{t("term.format")}</span>
				<span class="hidden group-data-formatting:inline">...</span>
			</button>
			-->
			<button
				id="btn-run-mobile"
				type="button"
				aria-label={t("term.run_aria")}
				class="btn btn-primary btn-sm flex-1 touch-manipulation"
			>
				<IconPlayerPlay class="group-data-running:hidden" font-size={18} />
				<IconLoader2 class="hidden animate-spin group-data-running:block" font-size={18} />
				<span class="group-data-running:hidden">{t("term.run")}</span>
				<span class="hidden group-data-running:inline">{t("term.running")}</span>
			</button>
		</div>
		<div class="hidden items-center gap-2 border-t border-code-line px-3 py-2 font-mono group-data-running:flex">
			<span class="text-code-muted text-sm">›</span>
			<input
				id="stdin-input-mobile"
				type="text"
				placeholder="stdin..."
				class="flex-1 bg-transparent text-xs text-code-ink outline-none placeholder:text-code-muted"
				aria-label={t("term.stdin_aria")}
			/>
		</div>
	</div>
</terminal-output>

<script>
import { rustPlayground } from "~/lib/rust-playground";
import { db, editorCode, pendingEditorCode } from "~/lib/stores/editor-store";
import { getStderrHTML } from "~/components/editor/output/renderer";

class TerminalOutput extends HTMLElement {
	private ui = {
		stdin: document.getElementById("stdin-input") as HTMLInputElement,
		stdinMobile: document.getElementById("stdin-input-mobile") as HTMLInputElement | null,
		console: document.getElementById("console") as HTMLDivElement,
		stderr: document.getElementById("stderr") as HTMLPreElement,
		stdout: document.getElementById("stdout") as HTMLPreElement,
		btnRun: document.getElementById("btn-run") as HTMLButtonElement,
		btnReset: document.getElementById("btn-reset") as HTMLButtonElement,
		btnFormat: document.getElementById("btn-format") as HTMLButtonElement | null,
		btnRunMobile: document.getElementById("btn-run-mobile") as HTMLButtonElement | null,
		btnResetMobile: document.getElementById("btn-reset-mobile") as HTMLButtonElement | null,
		btnFormatMobile: document.getElementById("btn-format-mobile") as HTMLButtonElement | null,
	};

	private state = {
		lastStderr: "",
		output: "",
	};

	connectedCallback() {
		this.ui.btnRun.addEventListener("click", this.execute);
		this.ui.btnReset.addEventListener("click", this.reset);
		this.ui.btnFormat?.addEventListener("click", this.format);
		this.ui.btnRunMobile?.addEventListener("click", this.execute);
		this.ui.btnResetMobile?.addEventListener("click", this.reset);
		this.ui.btnFormatMobile?.addEventListener("click", this.format);
		this.ui.stdin.addEventListener("keydown", this.handleStdin);
		this.ui.stdinMobile?.addEventListener("keydown", this.handleStdin);
	}

	private isScrolledToBottom(): boolean {
		const { scrollTop, scrollHeight, clientHeight } = this.ui.console;
		return scrollHeight - scrollTop - clientHeight < 5;
	}

	private handleStdin = (e: KeyboardEvent) => {
		if (e.key !== "Enter") return;

		e.preventDefault();
		const input = e.currentTarget as HTMLInputElement;
		const value = input.value.trim();

		if (value) {
			rustPlayground.sendStdin(`${value}\n`);
			input.value = "";
			this.scrollToBottom();
		}
	}

	private execute = () => {
		this.setRunning(true);
		this.clear();
		this.ui.stdin.focus();

		const testCode = this.dataset.testCode;
		if (testCode) {
			const fullCode = editorCode.get() + "\n" + testCode;
			rustPlayground.execute(fullCode, this.handleOutput, this.handleComplete, { tests: true });
		} else {
			rustPlayground.execute(editorCode.get(), this.handleOutput, this.handleComplete);
		}
	}

	private handleOutput = (stderr: string, stdout: string) => {
		const wasAtBottom = this.isScrolledToBottom();

		if (stderr && stderr !== this.state.lastStderr) {
			this.state.lastStderr = stderr;
			this.ui.stderr.innerHTML = getStderrHTML(stderr);
		}

		if (stdout) {
			this.state.output = stdout;
			this.ui.stdout.innerHTML = this.dataset.testCode
				? this.formatTestOutput(stdout)
				: stdout;
		}

		if (wasAtBottom) {
			this.scrollToBottom();
		}
	}

	private formatTestOutput(output: string): string {
		return output
			.split("\n")
			.map(line => {
				if (line.includes("... ok")) {
					return `<span class="text-code-success">${line}</span>`
				}
				if (line.includes("... FAILED") || line.includes("FAILED")) {
					return `<span class="text-code-danger">${line}</span>`
				}
				if (line.startsWith("test result:")) {
					const passed = line.includes("FAILED")
					return `<span class="${passed ? "text-code-danger" : "text-code-success"} font-bold">${line}</span>`
				}
				return `<span class="text-code-muted">${line}</span>`
			})
			.join("\n")
	}

	private handleComplete = async (success: boolean) => {
		this.setRunning(false);

		const isTestMode = !!this.dataset.testCode;
		const slug = document.querySelector<HTMLElement>("[data-slug]")?.dataset.slug;
		const courseId = document.querySelector<HTMLElement>("[data-track-id]")?.dataset.trackId;

		if (isTestMode) {
			if (success && slug) {
				await db.markCompleted(slug, courseId);
				window.dispatchEvent(new CustomEvent("lesson:completed"));
			}
			return;
		}

		const expected = this.dataset.expected?.trim();
		const actual = this.state.output.trim();
		const outputMatches = !expected || expected === actual;

		if (success && outputMatches && slug) {
			await db.markCompleted(slug, courseId);
			window.dispatchEvent(new CustomEvent("lesson:completed"));
		}

		if (success && expected && !outputMatches) {
			this.showMismatch(expected, actual);
		}
	}

	private showMismatch(expected: string, _actual: string) {
		const mismatchDiv = document.createElement('div');
		mismatchDiv.innerHTML = `<hr class="border-t border-code-line my-2"><div><b><span class="text-code-danger">error</span>: La salida no coincide con lo esperado</b></div><div>  Esperaba: <span class="text-code-success">${expected}</span></div>`;

		this.ui.stderr.innerHTML = getStderrHTML(this.state.lastStderr);
		this.ui.stderr.appendChild(mismatchDiv);
		this.scrollToBottom();
	}

	private reset = async () => {
		const editor = document.querySelector("[data-slug]") as HTMLElement;
		if (!editor) return;

		const { slug, initialCode } = editor.dataset;
		if (!slug || !initialCode) return;

		await db.reset(slug);
		editorCode.set(initialCode);
		window.dispatchEvent(new CustomEvent("editor:reset", { detail: { code: initialCode } }));
	}

	private format = async () => {
		this.setFormatting(true);
		try {
			const response = await fetch("https://play.rust-lang.org/format", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ channel: "stable", edition: "2024", code: editorCode.get() }),
			});
			const result = await response.json() as { success: boolean; code: string };
			if (result.success && result.code) {
				pendingEditorCode.set(result.code);
			}
		} catch {
			// silent fail
		} finally {
			this.setFormatting(false);
		}
	}

	private setFormatting(formatting: boolean) {
		this.toggleAttribute("data-formatting", formatting);
	}

	private setRunning(running: boolean) {
		this.toggleAttribute("data-running", running);
	}

	private clear() {
		this.ui.stderr.textContent = "";
		this.ui.stdout.textContent = "";
		this.state.lastStderr = "";
		this.state.output = "";
	}

	private scrollToBottom() {
		this.ui.console.scrollTop = this.ui.console.scrollHeight;
	}
}

customElements.define("terminal-output", TerminalOutput);
</script>
