---
import { defaultLang, ui } from "~/i18n/ui"

const lang = Astro.locals.lang ?? defaultLang

type TranslationKey = keyof (typeof ui)[typeof defaultLang]
const t = (key: TranslationKey) => ui[lang][key] ?? ui[defaultLang][key]
const projectId = import.meta.env.VITE_CLARITY_PROJECT_ID
---

<div
  id="privacy-overlay"
  class="hidden fixed inset-0 z-50 bg-black/50 items-center justify-center p-4"
>
  <div
    id="privacy-banner"
    data-clarity-id={projectId}
    class="card shadow-hard w-full max-w-2xl max-h-[90vh] overflow-hidden grid grid-cols-1 md:grid-cols-2"
  >
    <div class="relative aspect-4/3 md:aspect-auto border-b md:border-b-0 md:border-r border-line">
      <img
        src="/images/webp/ferris_cooking.jpg"
        alt={t("cookie.banner.img.alt")}
        class="absolute inset-0 w-full h-full object-cover"
      />
    </div>

    <div class="flex flex-col justify-center gap-5 p-6 overflow-y-auto">
      <div class="flex flex-col gap-3">
        <h2 class="type-h4 text-ink">{t("cookie.banner.title")}</h2>
        <p class="text-sm text-ink-muted leading-relaxed">
          {t("cookie.banner.purpose")}
        </p>
        <p class="text-sm text-ink-muted leading-relaxed">
          {t("cookie.banner.company.also")}
          <span class="text-ink font-medium">{t("cookie.banner.company")}</span>{t("cookie.banner.company.description")}
        </p>
        <p class="text-xs text-ink-subtle leading-relaxed">
          {t("cookie.banner.accept")}
          <a
            href="/privacidad"
            target="_blank"
            rel="noopener noreferrer"
            class="text-ferris-ink underline underline-offset-2 hover:no-underline"
          >{t("policy.privacy")}</a>.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <button
          id="reject-cookies"
          type="button"
          class="btn btn-secondary btn-sm flex-1 px-4"
        >
          {t("text.denied")}
        </button>
        <button
          id="accept-cookies"
          type="button"
          class="btn btn-primary btn-sm flex-1 px-4"
        >
          {t("text.accept")}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const overlay = document.getElementById("privacy-overlay")
  const banner = document.getElementById("privacy-banner")
  const projectId = banner?.dataset.clarityId ?? ""

  async function loadClarity() {
    try {
      if (projectId) {
        const { default: Clarity } = await import("@microsoft/clarity")
        Clarity.init(projectId)
        Clarity.consentV2({ ad_Storage: "granted", analytics_Storage: "granted" })
      }
    } catch {}
  }

  function showOverlay() {
    overlay?.classList.remove("hidden")
    overlay?.classList.add("flex")
  }

  function hideOverlay() {
    overlay?.classList.remove("flex")
    overlay?.classList.add("hidden")
  }

  let consent = null
  try {
    consent = localStorage.getItem("cookiesAccepted")
  } catch {}

  const isPrivacyPage = window.location.pathname === "/privacidad"

  if (consent === "true") {
    loadClarity()
  } else if (consent === null && !isPrivacyPage) {
    showOverlay()
  }

  document.getElementById("accept-cookies")?.addEventListener("click", () => {
    try {
      localStorage.setItem("cookiesAccepted", "true")
    } catch {}
    loadClarity()
    hideOverlay()
  })

  document.getElementById("reject-cookies")?.addEventListener("click", () => {
    try {
      localStorage.setItem("cookiesAccepted", "false")
    } catch {}
    hideOverlay()
  })

  function watchBannerIntegrity() {
    const currentOverlay = document.getElementById("privacy-overlay")
    const currentBanner = document.getElementById("privacy-banner")
    if (!currentBanner || !currentOverlay) return

    const isBroken = () => {
      const style = getComputedStyle(currentBanner)
      return (
        style.display === "none" ||
        style.visibility === "hidden" ||
        currentBanner.offsetWidth === 0 ||
        currentBanner.offsetHeight === 0
      )
    }

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        if (isBroken()) {
          currentOverlay.remove()
        }
      })
    })

    const observer = new MutationObserver(() => {
      if (isBroken()) {
        observer.disconnect()
        currentOverlay.remove()
      }
    })

    observer.observe(currentBanner, {
      attributes: true,
      attributeFilter: ["style", "class", "hidden"],
    })
  }

  watchBannerIntegrity()

  document.addEventListener("astro:page-load", () => {
    watchBannerIntegrity()
  })
</script>
