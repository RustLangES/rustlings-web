---
import IconMoon from "~icons/tabler/moon"
import IconSun from "~icons/tabler/sun"

interface Props {
	label?: string
}

const { label = "Cambiar tema" } = Astro.props
---

<button type="button" class="btn-icon" data-theme-toggle aria-label={label} title={label}>
  <IconMoon font-size={18} class="dark:hidden" aria-hidden="true" />
  <IconSun font-size={18} class="hidden dark:block" aria-hidden="true" />
</button>

<script>
  function bindThemeToggles() {
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
      if (btn.dataset.bound) return
      btn.dataset.bound = "true"
      btn.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark"
        document.documentElement.dataset.theme = next
        try {
          localStorage.setItem("theme", next)
        } catch {}
      })
    })
  }

  document.addEventListener("astro:page-load", bindThemeToggles)
</script>
