---
import { getLangFromUrl, useTranslations } from "~/i18n/utils"
import IconLeft from "~icons/tabler/arrow-big-left-lines-filled"
import IconCheck from "~icons/tabler/check"
import IconX from "~icons/tabler/x"

export interface SidebarItem {
	label: string
	href?: string
	icon?: string
	children?: SidebarItem[]
}

interface Props {
	title?: string
	items?: SidebarItem[]
	position?: "left" | "right"
	id?: string
	logo?: string
	backHref?: string
	backLabel?: string
	lang?: string
}

const {
	title: titleProp,
	items = [],
	position = "left",
	id = "sidebar",
	logo,
	backHref,
	backLabel: backLabelProp,
	lang: langProp,
} = Astro.props

const lang = langProp ?? getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const title = titleProp ?? t("sidebar.menu")
const backLabel = backLabelProp ?? t("sidebar.back")
---

<div
	data-sidebar-overlay={id}
	class="fixed inset-0 z-100 invisible bg-black/40 opacity-0 transition-[opacity,visibility] duration-200"
	role="presentation"
	aria-hidden="true"
></div>

<aside
	data-sidebar={id}
	aria-label={title}
	inert
	class:list={[
		"fixed inset-y-0 z-101 flex w-80 max-w-[85vw] flex-col border-line bg-canvas transition-transform duration-200 ease-out-quint",
		{
			"right-0 border-l translate-x-full": position === "right",
			"left-0 border-r -translate-x-full": position === "left"
		}
	]}
>
	<header class="flex flex-col gap-4 border-b border-line px-4 pt-6 pb-4">
		{logo && (
			<a
				href="/"
				class="mx-auto flex items-center justify-center rounded-card border border-line bg-ferris-tint p-3 shadow-hard-sm transition-transform duration-150 hover:-translate-x-px hover:-translate-y-px"
			>
				<img
					src={logo}
					alt="Rustlings Web"
					class="h-14 w-14"
				/>
			</a>
		)}

		<div class="flex items-center justify-between">
			<span class="type-overline text-ink-muted">
				{title}
			</span>
			<button
				type="button"
				data-sidebar-close={id}
				aria-label={t("sidebar.close_menu")}
				class="btn-icon"
			>
				<IconX font-size={20} aria-hidden="true" />
			</button>
		</div>
	</header>

	<nav class="flex-1 overflow-y-auto p-4" aria-label={`${t("sidebar.navigation_of")} ${title.toLowerCase()}`}>
		{backHref && (
			<a
				href={backHref}
				class="btn btn-secondary btn-sm mb-4 w-full justify-start"
			>
				<IconLeft font-size={20} aria-hidden="true" />
				{backLabel}
			</a>
		)}
		<ul class="overflow-hidden rounded-xl border border-line bg-surface shadow-hard-sm divide-y divide-line">
			{items.map((item) => (
				<li>
					<a
						href={item.href}
						data-sidebar-link={id}
						class="flex min-h-12 items-center gap-3 px-4 py-3 text-sm font-semibold text-ink transition-colors duration-150 hover:bg-surface-raised hover:text-ferris-ink aria-[current=page]:bg-ferris-tint aria-[current=page]:text-ferris-ink aria-[current=page]:shadow-[inset_4px_0_0_0_var(--ferris-ink)]"
					>
						{item.icon && <span class="text-lg" aria-hidden="true">{item.icon}</span>}
						<span class="flex-1">{item.label}</span>
						<span data-visited-check class="status-dot hidden bg-success-bg text-success" aria-hidden="true">
							<IconCheck font-size={12} class="m-px block" />
						</span>
					</a>
					{item.children && item.children.length > 0 && (
						<ul class="border-t border-line-soft bg-canvas divide-y divide-line-soft">
							{item.children.map((child) => (
								<li>
									<a
										href={child.href}
										data-sidebar-link={id}
										class="flex min-h-10 items-center gap-2 py-2 pr-4 pl-10 text-sm text-ink-muted transition-colors duration-150 hover:bg-surface-raised hover:text-ferris-ink aria-[current=page]:bg-ferris-tint aria-[current=page]:font-semibold aria-[current=page]:text-ferris-ink aria-[current=page]:shadow-[inset_4px_0_0_0_var(--ferris-ink)]"
									>
										<span class="flex-1">{child.label}</span>
										<span data-visited-check class="status-dot hidden bg-success-bg text-success" aria-hidden="true">
											<IconCheck font-size={12} class="m-px block" />
										</span>
									</a>
								</li>
							))}
						</ul>
					)}
				</li>
			))}
		</ul>
	</nav>
</aside>

<template id="lock-icon-tpl">
  <svg
    data-lock
    xmlns="http://www.w3.org/2000/svg"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="shrink-0"
  >
    <rect x="5" y="11" width="14" height="10" rx="2"/>
    <path d="M8 11V7a4 4 0 0 1 8 0v4"/>
  </svg>
</template>

<script>
  import { db } from "~/lib/stores/editor-store"

  // Locks depend on server progress: a learner on a new device (or landing straight on a
  // lesson) has an empty local store until it is synced. Sync once per browser session.
  let synced: Promise<void> | null = null

  async function updateLock() {
    const links = [
      ...document.querySelectorAll<HTMLAnchorElement>("[data-sidebar-link]"),
    ]
    if (!links.length) return

    synced ??= db.syncFromServer()
    await synced

    let locked = false

    for (const link of links) {
      const href = link.getAttribute("href") ?? ""
      const slug = href.split("/").pop() ?? ""
      const isActive = href === window.location.pathname

      if (locked && !isActive) {
        lockLink(link)
      } else {
        unlockLink(link)
        if (slug) {
          const done = await db.isCompleted(slug)
          if (!done) locked = true
        }
      }
    }
  }

  function lockLink(link: HTMLAnchorElement) {
    link.classList.add("opacity-50", "pointer-events-none")
    if (!link.querySelector("[data-lock]")) {
      const tpl = document.getElementById("lock-icon-tpl") as HTMLTemplateElement | null
      if (tpl) {
        const node = tpl.content.cloneNode(true) as DocumentFragment
        link.appendChild(node)
      }
    }
  }

  function unlockLink(link: HTMLAnchorElement) {
    link.classList.remove("opacity-50", "pointer-events-none")
    link.querySelector("[data-lock]")?.remove()
  }

  document.addEventListener("astro:page-load", updateLock)
  window.addEventListener("lesson:completed", updateLock)
</script>

<script define:vars={{ id }}>
	function initSidebar() {
		const sidebar = document.querySelector(`[data-sidebar="${id}"]`)
		const overlay = document.querySelector(`[data-sidebar-overlay="${id}"]`)
		const closeBtn = document.querySelector(`[data-sidebar-close="${id}"]`)
		const links = document.querySelectorAll(`[data-sidebar-link="${id}"]`)

		if (!sidebar || !overlay) return

		const close = () => {
			const isRight = sidebar.classList.contains('right-0')
			sidebar.classList.add(isRight ? 'translate-x-full' : '-translate-x-full')
			sidebar.toggleAttribute('inert', true)
			overlay.classList.add('opacity-0', 'invisible')
		}

		const open = () => {
			sidebar.classList.remove('translate-x-full', '-translate-x-full')
			sidebar.toggleAttribute('inert', false)
			overlay.classList.remove('opacity-0', 'invisible')
		}

		const toggle = () => {
			const isOpen = !sidebar.classList.contains('translate-x-full') && !sidebar.classList.contains('-translate-x-full')
			isOpen ? close() : open()
		}

		const handleEscape = (e) => e.key === 'Escape' && close()

		closeBtn?.addEventListener('click', close)
		overlay.addEventListener('click', close)
		links.forEach(link => link.addEventListener('click', close))
		document.addEventListener('keydown', handleEscape)

		const getVisitedSlugs = () => {
			try {
				const progress = JSON.parse(localStorage.getItem('rustlings_progress') ?? '{}')
				return Object.values(progress).flat()
			} catch { return [] }
		}

		const highlightActive = () => {
			const current = window.location.pathname
			const visited = getVisitedSlugs()

			links.forEach(link => {
				const href = link.getAttribute('href') ?? ''
				const slug = href.split('/').pop() ?? ''
				const isActive = href === current

				if (isActive) link.setAttribute('aria-current', 'page')
				else link.removeAttribute('aria-current')

				const check = link.querySelector('[data-visited-check]')
				if (!check) return

				const childList = link.parentElement?.querySelector('ul')
				let isVisited
				if (childList) {
					const childSlugs = [...childList.querySelectorAll(`a[data-sidebar-link="${id}"]`)]
						.map(a => (a.getAttribute('href') ?? '').split('/').pop() ?? '')
					isVisited = childSlugs.length > 0 && childSlugs.every(s => visited.includes(s))
				} else {
					isVisited = visited.includes(slug)
				}

				check.classList.toggle('hidden', !isVisited)
			})
		}

		highlightActive()

		window[`${id}Sidebar`] = { open, close, toggle }

		return () => {
			closeBtn?.removeEventListener('click', close)
			overlay.removeEventListener('click', close)
			links.forEach(link => link.removeEventListener('click', close))
			document.removeEventListener('keydown', handleEscape)
			delete window[`${id}Sidebar`]
		}
	}

	document.addEventListener('astro:page-load', initSidebar)
</script>
